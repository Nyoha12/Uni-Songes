{{ attach_library('unisonges_theme/unisonges-layout') }}
{% include '@unisonges_theme/partials/site-header.html.twig' %}
{% set site_title = site_name|default('Uni-Songes') %}

<section class="home-hero">
  <div class="container home-hero__inner">
    <h1 class="home-hero__title">{{ site_title }}</h1>
    <div class="home-hero__actions">
      <a class="btn btn--cta" href="/reserver">Réserver</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="home-cards">
      <a class="home-card" href="/cours"><span class="home-card__title">Cours</span></a>
      <a class="home-card" href="/stages"><span class="home-card__title">Stages</span></a>
      <a class="home-card" href="/concerts"><span class="home-card__title">Concerts & dates à venir</span></a>
      <a class="home-card" href="/association"><span class="home-card__title">L’Association</span></a>
      <a class="home-card" href="/djam"><span class="home-card__title">D’Jam</span></a>
      <a class="home-card" href="/orchestre-des-reveurs"><span class="home-card__title">Orchestre des rêveurs</span></a>
      <a class="home-card" href="/contact"><span class="home-card__title">Contact</span></a>
    </div>
  </div>
</section>
