{{ attach_library('unisonges_theme/unisonges-layout') }}
<div id="unisonges-bgfx" aria-hidden="true">
  <div id="unisonges-bgfx-scroll">
    <div id="unisonges-bgfx-layer"></div>
  </div>
</div>

{% include '@unisonges_theme/partials/site-header.html.twig' %}

<div id="unisonges-scrollframe" class="scrollframe">
  <div class="scrollframe__inner">
    <main id="main-content" class="d-flex flex-column" role="main">
      {% if page.highlighted %}{{ page.highlighted }}{% endif %}
      {% if page.help %}{{ page.help }}{% endif %}
      {{ page.content }}
    </main>

    {% include '@unisonges_theme/includes/_footer.html.twig' with { 'footer_region': page.footer } only %}
  </div>
</div>
