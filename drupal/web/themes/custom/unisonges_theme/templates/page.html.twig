<header class="site-header" role="banner">
  <div class="container header-inner">
    <a class="brand" href="{{ path('<front>') }}">UniSonges</a>

    <nav class="unisonges-main-nav" aria-label="Navigation principale">
      {{ unisonges_main_menu }}
    </nav>

    <div class="account-wrap">
      <a class="btn-wood" href="#" aria-label="Mon compte (bientôt)">Mon compte</a>
      <div class="header-quicklinks" aria-label="Accès rapide">
        <a href="{{ path('<front>') }}reserver-un-cours">Réserver un cours</a>
        <a href="{{ path('<front>') }}stages">Voir les stages</a>
