  {% include '@unisonges_theme/includes/_hero.html.twig' with { title: label, intro: 'Un accompagnement intermédiaire pour enrichir votre souffle, rythme et musicalité.' } only %}
  {% if content.body %}
    <section class="panel node-body">{{ content.body }}</section>
  {% endif %}
  {% include '@unisonges_theme/includes/_actions-row.html.twig' with {
