{% set portal = unisonges_reservation_portal|default({}) %}
{% set is_anonymous = portal.is_anonymous is defined ? portal.is_anonymous : true %}
{% set can_use_existing_right = (not is_anonymous) and (portal.can_book|default(false)) %}
{% set tunnel_url = portal.tunnel_url|default('/reservation-cours') %}
{% set login_url = portal.login_url|default('/user/login?destination=/reservation-cours') %}
{% set register_url = portal.register_url|default('/user/register?destination=/reservation-cours') %}
{% set reservation_form = unisonges_reservation_form|default([]) %}

<article class="unisonges-node-page reservation-portal">
  {% include '@unisonges_theme/includes/_hero.html.twig' with {
    title: 'Réserver un cours',
    intro: 'Le parcours présente les étapes dans cet ordre : compte, cours, créneau, détails, paiement, puis confirmation.'
  } only %}

  <section class="reservation-portal__intro" aria-labelledby="reservation-primary-title">
    <h2 id="reservation-primary-title">Commencer ma réservation</h2>
    <p>Pour un paiement en ligne, le créneau choisi n’est pas réservé.</p>
    <div class="reservation-portal__actions">
      <a class="btn btn--cta" href="{{ tunnel_url }}">Commencer ma réservation</a>
    </div>
  </section>

  {% if is_anonymous %}
    <section class="reservation-portal__intro" aria-labelledby="reservation-account-title">
      <div class="reservation-portal__account">
        <h2 id="reservation-account-title">Se connecter ou créer un compte</h2>
        <p>Un compte est nécessaire pour confirmer une réservation.</p>
        <div class="reservation-portal__actions">
          <a class="btn" href="{{ login_url }}">Se connecter pour réserver</a>
          <a class="btn" href="{{ register_url }}">Créer un compte pour réserver</a>
        </div>
      </div>
    </section>
  {% endif %}

  {% if can_use_existing_right and reservation_form is not empty %}
    <section class="reservation-portal__form" aria-labelledby="reservation-existing-right-title">
      <h2 id="reservation-existing-right-title">Utiliser un droit déjà disponible</h2>
      <p>Cette option sert uniquement à utiliser une séance déjà disponible sur votre compte ou un cours à payer déjà enregistré.</p>
      {{ reservation_form }}
    </section>
  {% endif %}
</article>
