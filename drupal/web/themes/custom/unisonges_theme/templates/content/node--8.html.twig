{% set portal = unisonges_reservation_portal|default({}) %}
{% set portal_status = portal.status|default('anonymous') %}
{% set confirmation = unisonges_reservation_confirmation|default(null) %}
{% set body_markup = content.body|render %}
{% set flow_steps = {
  account: 'Compte',
  slot: 'Créneau',
  payment: 'Paiement',
  confirmation: 'Confirmation'
} %}
{% set flow_current = confirmation ? 'confirmation' : (portal.is_anonymous ? 'account' : 'slot') %}
{% set flow_completed = confirmation ? ['account', 'slot', 'payment'] : (portal.is_anonymous ? [] : ['account']) %}

<article class="unisonges-node-page reservation-portal">
  {% include '@unisonges_theme/includes/_hero.html.twig' with {
    title: 'Réserver un cours',
    intro: 'Choisissez un créneau de cours particulier, puis complétez les informations utiles pour préparer la séance.'
  } only %}

  <section class="reservation-portal__intro">
    <p>Les disponibilités sont consultables sans compte. Pour confirmer une réservation, connectez-vous avec un compte disposant d’une séance active.</p>
  </section>

  <nav class="course-flow-progress" aria-label="Progression de réservation">
    <ol>
      {% for key, label in flow_steps %}
        {% set state_class = key == flow_current ? 'is-current' : (key in flow_completed ? 'is-complete' : 'is-upcoming') %}
        <li class="course-flow-progress__step {{ state_class }}"{% if key == flow_current %} aria-current="step"{% endif %}>
          <span class="course-flow-progress__marker" aria-hidden="true"></span>
          <span class="course-flow-progress__label">{{ label }}</span>
        </li>
      {% endfor %}
    </ol>
  </nav>

  <section class="reservation-portal__summary reservation-portal__summary--{{ portal_status }}" aria-labelledby="reservation-access-title" aria-describedby="reservation-access-message">
    <div class="reservation-portal__account">
      <h2 id="reservation-access-title">Votre accès réservation</h2>
      <p class="reservation-portal__status">{{ portal.status_label }}</p>
      <p id="reservation-access-message">{{ portal.message }}</p>

      {% if portal.is_anonymous %}
        <div class="reservation-portal__actions">
          <a class="btn btn--cta" href="{{ portal.login_url }}">Se connecter pour réserver</a>
          <a class="btn" href="{{ portal.register_url }}">Créer un compte</a>
        </div>
      {% else %}
        <dl class="reservation-portal__rights">
          <div>
            <dt>Séances restantes</dt>
            <dd>{{ portal.remaining_label }}</dd>
          </div>
          {% if portal.expiry_label %}
            <div>
              <dt>Validité</dt>
              <dd>{{ portal.expiry_label }}</dd>
            </div>
          {% endif %}
        </dl>

        {% if portal.can_book %}
          <div class="reservation-portal__actions">
            <a class="btn btn--cta" href="#reservation-form-title">Choisir un créneau</a>
          </div>
        {% else %}
          <div class="reservation-portal__actions">
            <a class="btn btn--cta" href="{{ portal.purchase_url }}">{{ portal.purchase_label }}</a>
          </div>
        {% endif %}
      {% endif %}
    </div>

    <div class="reservation-portal__steps" aria-label="Fonctionnement">
      <h2>Comment ça se passe</h2>
      <ol>
        <li>Consultez les créneaux disponibles.</li>
        <li>Connectez-vous ou vérifiez vos séances restantes.</li>
        <li>Choisissez le mode du cours et validez la demande.</li>
      </ol>
    </div>
  </section>

  {% if body_markup|striptags|trim %}
    <section class="panel node-body">{{ body_markup }}</section>
  {% endif %}

  {% if confirmation %}
    <section class="reservation-confirmation" aria-labelledby="reservation-confirmation-title">
      <h2 id="reservation-confirmation-title">Réservation enregistrée</h2>
      <p class="reservation-confirmation__lead">Votre créneau est confirmé dans le parcours de réservation.</p>

      <dl class="reservation-confirmation__details">
        <div>
          <dt>Créneau</dt>
          <dd>{{ confirmation.slot_label }}</dd>
        </div>
        <div>
          <dt>Cours</dt>
          <dd>{{ confirmation.course_label }}</dd>
        </div>
        {% if confirmation.mode_label %}
          <div>
            <dt>Mode</dt>
            <dd>{{ confirmation.mode_label }}</dd>
          </div>
        {% endif %}
        {% if confirmation.instrument_label %}
          <div>
            <dt>Instrument</dt>
            <dd>{{ confirmation.instrument_label }}</dd>
          </div>
        {% endif %}
        {% if confirmation.level_label %}
          <div>
            <dt>Niveau</dt>
            <dd>{{ confirmation.level_label }}</dd>
          </div>
        {% endif %}
        {% if confirmation.location_label %}
          <div>
            <dt>Lieu</dt>
            <dd>{{ confirmation.location_label }}</dd>
          </div>
        {% endif %}
        <div>
          <dt>Paiement</dt>
          <dd><span class="reservation-confirmation__payment reservation-confirmation__payment--{{ confirmation.payment_status }}">{{ confirmation.payment_label }}</span></dd>
        </div>
      </dl>

      <p class="reservation-confirmation__payment-detail">{{ confirmation.payment_detail }}</p>

      <div class="reservation-portal__actions">
        <a class="btn btn--cta" href="{{ confirmation.account_url }}">Retour à mon compte</a>
        <a class="btn" href="{{ confirmation.home_url }}">Retour à l’accueil</a>
      </div>
    </section>
  {% else %}
    <section class="reservation-portal__form" aria-labelledby="reservation-form-title">
      <h2 id="reservation-form-title">Choisir un créneau</h2>
      {{ unisonges_reservation_form }}
    </section>
  {% endif %}
</article>
