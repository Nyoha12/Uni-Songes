<?php

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * @file
 * Theme integration for the Uni-Songes editorial homepage.
 */

/**
 * Implements hook_theme().
 */
function unisonges_editorial_home_theme(
  array $existing,
  string $type,
  string $theme,
  string $path,
): array {
  return [
    'unisonges_editorial_home' => [
      'variables' => [
        'articles' => [],
        'themes' => [],
        'selected_theme' => NULL,
        'selected_theme_name' => NULL,
        'theme_filtered' => FALSE,
        'theme_invalid' => FALSE,
        'pager' => [],
        'all_articles_url' => NULL,
        'about_url' => NULL,
      ],
      'template' => 'unisonges-editorial-home',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for the protected homepage body.
 */
function unisonges_editorial_home_node_presave(NodeInterface $node): void {
  if ($node->isNew() || $node->bundle() !== 'page' || !$node->hasField('body')) {
    return;
  }

  $front_path = \Drupal::service('path_alias.manager')
    ->getPathByAlias('/accueil');
  $front_node_id = preg_match(
    '/^\/node\/([1-9][0-9]*)$/D',
    $front_path,
    $matches,
  ) === 1 ? (int) $matches[1] : NULL;

  $state_sentinel = new stdClass();
  $rollback_state = \Drupal::state()->get(
    'unisonges_editorial_home.rollback.v1',
    $state_sentinel,
  );
  $state_exists = $rollback_state !== $state_sentinel;
  $state_node_id = is_array($rollback_state)
    && is_int($rollback_state['homepage']['identity']['id'] ?? NULL)
      ? $rollback_state['homepage']['identity']['id']
      : NULL;

  $node_id = (int) $node->id();
  if ($node_id !== $front_node_id && $node_id !== $state_node_id) {
    return;
  }
  if ($front_node_id === NULL
    || ($state_exists && $state_node_id !== $front_node_id)) {
    throw new RuntimeException(
      'Could not reconcile the protected /accueil alias and rollback identity.',
    );
  }

  $original = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadUnchanged($node->id());
  if (!$original instanceof NodeInterface || !$original->hasField('body')) {
    throw new RuntimeException(
      'Could not verify the protected /accueil body before save.',
    );
  }
  $original_body = unisonges_editorial_home_guard_body_snapshot($original);
  $target_body = unisonges_editorial_home_guard_body_snapshot($node);
  if ($original_body === $target_body) {
    return;
  }

  $authorization = $GLOBALS[
    'UNISONGES_EDITORIAL_HOME_BODY_TRANSITION_AUTHORIZATION'
  ] ?? NULL;
  $authorized_transition = PHP_SAPI === 'cli'
    && is_array($authorization)
    && array_keys($authorization) === [
      'version',
      'action',
      'plan_token',
      'git_head',
      'node_id',
      'expected_body',
      'target_body',
    ]
    && $authorization['version'] === 1
    && $authorization['node_id'] === $front_node_id
    && $authorization['expected_body'] === $original_body
    && $authorization['target_body'] === $target_body
    && getenv('UNISONGES_EDITORIAL_HOME_MODE') === 'apply'
    && is_string($authorization['action'])
    && getenv('UNISONGES_EDITORIAL_HOME_ACTION') === $authorization['action']
    && in_array($authorization['action'], ['install', 'rollback'], TRUE)
    && is_string($authorization['plan_token'])
    && preg_match(
      '/^[a-f0-9]{64}$/D',
      $authorization['plan_token'],
    ) === 1
    && hash_equals(
      getenv('UNISONGES_EDITORIAL_HOME_PLAN_TOKEN') ?: '',
      $authorization['plan_token'],
    )
    && is_string($authorization['git_head'])
    && preg_match(
      '/^[a-f0-9]{40}$/D',
      $authorization['git_head'],
    ) === 1
    && hash_equals(
      getenv('UNISONGES_EDITORIAL_HOME_GIT_HEAD') ?: '',
      $authorization['git_head'],
    )
    && defined('UNISONGES_EDITORIAL_HOME_BODY_TRANSITION_AUTHORIZATION')
    && is_string(UNISONGES_EDITORIAL_HOME_BODY_TRANSITION_AUTHORIZATION)
    && hash_equals(
      $authorization['plan_token'],
      UNISONGES_EDITORIAL_HOME_BODY_TRANSITION_AUTHORIZATION,
    );
  if (!$authorized_transition) {
    throw new RuntimeException(
      'The editorial-home feature protects /accueil; use its dry-run-first installer or exact rollback.',
    );
  }
}

/**
 * Normalize the guarded Body tuple without rendering or deriving content.
 */
function unisonges_editorial_home_guard_body_snapshot(NodeInterface $node): array {
  $items = $node->get('body')->getValue();
  if ($items === []) {
    return [
      'empty' => TRUE,
      'value' => '',
      'format' => NULL,
      'summary' => NULL,
      'items' => [],
    ];
  }
  if (count($items) !== 1 || !is_array($items[0])) {
    throw new RuntimeException('The protected /accueil Body is malformed.');
  }
  $value = $items[0]['value'] ?? NULL;
  $format = $items[0]['format'] ?? NULL;
  $summary = $items[0]['summary'] ?? NULL;
  if (!is_string($value)
    || !is_string($format)
    || (!is_string($summary) && $summary !== NULL)) {
    throw new RuntimeException('The protected /accueil Body tuple is invalid.');
  }
  return [
    'empty' => FALSE,
    'value' => $value,
    'format' => $format,
    'summary' => $summary,
    'items' => [[
      'value' => $value,
      'format' => $format,
      'summary' => $summary,
    ]],
  ];
}
