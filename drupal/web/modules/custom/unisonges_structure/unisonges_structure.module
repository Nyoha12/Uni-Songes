<?php

/**
 * @file
 * Hooks and custom code for the Unisonges Structure module.
 */

/**
 * UNISONGES_AUTOGEN_TICKETS
 * Auto-create and keep in sync a Commerce ticket product for Stage/Concert nodes.
 *
 * Files:
 * - web/modules/custom/unisonges_structure/unisonges_structure.module
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\commerce_product\Entity\Product;
use Drupal\commerce_product\Entity\ProductVariation;

/**
 * Implements hook_entity_insert().
 */
function unisonges_structure_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    _unisonges_structure_sync_ticket_product($entity);
  }
  if ($entity instanceof \Drupal\commerce_order\Entity\OrderInterface) {
    _unisonges_structure_apply_course_rights_from_order($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function unisonges_structure_entity_update(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    _unisonges_structure_sync_ticket_product($entity);
  }
  if ($entity instanceof \Drupal\commerce_order\Entity\OrderInterface) {
    _unisonges_structure_apply_course_rights_from_order($entity);
  }
}

/**
 * Implements hook_cron().
 */
function unisonges_structure_cron(): void {
  try {
    $container = \Drupal::getContainer();
    if (!$container->has('unisonges_structure.booking_calendar_sync')) {
      return;
    }

    $container->get('unisonges_structure.booking_calendar_sync')->processPendingFromCron();
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_booking_sync')->error('Google Calendar booking sync cron failed: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Implements hook_mail().
 */
function unisonges_structure_mail(string $key, array &$message, array $params): void {
  if ($key !== 'course_rights_applied') {
    return;
  }

  $message['subject'] = (string) ($params['subject'] ?? 'Vos crédits de cours sont disponibles');
  $message['body'][] = (string) ($params['body'] ?? '');
}

/**
 * Implements hook_mail_alter().
 */
function unisonges_structure_mail_alter(array &$message): void {
  _unisonges_structure_alter_reservation_to_pay_mail($message);
}

/**
 * Implements hook_preprocess_node().
 */
function unisonges_structure_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || (int) $node->id() !== 8) {
    return;
  }

  $variables['unisonges_reservation_portal'] = _unisonges_structure_build_reservation_portal_context();
  $variables['unisonges_reservation_form'] = _unisonges_structure_build_course_reservation_form();

  $variables['elements']['#cache']['contexts'][] = 'user';
  $variables['content']['#cache']['contexts'][] = 'user';
}

/**
 * Ensure a Stage/Concert node has a linked ticket product; create/update it as needed.
 *
 * - Creates ticket product/variation if missing.
 * - Copies: title, linked page, (optional) ticket price, (optional) capacity mirror.
 * - Publishes/unpublishes product with node status ONLY if a ticket price is provided.
 *
 * Note: uses a recursion guard because we may save the node to store the product reference.
 */
function _unisonges_structure_sync_ticket_product(NodeInterface $node): void {
  $bundle = $node->bundle();
  if (!in_array($bundle, ['stage', 'concert'], TRUE)) {
    return;
  }

  static $in_progress = [];
  $nid = (int) $node->id();
  if ($nid && !empty($in_progress[$nid])) {
    return;
  }
  if ($nid) {
    $in_progress[$nid] = TRUE;
  }

  try {
    $product_type = $bundle === 'stage' ? 'ticket_stage' : 'ticket_concert';
    $variation_type = $product_type; // same ids in our setup

    // Resolve product: prefer reverse link field if present, else query by linked page.
    $product = NULL;
    if ($node->hasField('field_linked_ticket') && !$node->get('field_linked_ticket')->isEmpty()) {
      $pid = (int) $node->get('field_linked_ticket')->target_id;
      $product = $pid ? Product::load($pid) : NULL;
    }

    if (!$product) {
      $pids = \Drupal::entityQuery('commerce_product')
        ->accessCheck(FALSE)
        ->condition('type', $product_type)
        ->condition('field_linked_page.target_id', $nid)
        ->range(0, 1)
        ->execute();
      if ($pids) {
        $product = Product::load((int) reset($pids));
      }
    }

    // Read optional ticket price from node.
    $price = NULL;
    if ($node->hasField('field_ticket_price') && !$node->get('field_ticket_price')->isEmpty()) {
      $item = $node->get('field_ticket_price')->first();
      if ($item && method_exists($item, 'toPrice')) {
        $price = $item->toPrice();
      }
    }

    // Read optional capacity from node.
    $capacity = NULL;
    if ($node->hasField('field_capacity') && !$node->get('field_capacity')->isEmpty()) {
      $capacity = (int) $node->get('field_capacity')->value;
    }

    // Ensure product exists.
    if (!$product) {
      // Create variation first (unpublished by default).
      $variation = ProductVariation::create([
        'type' => $variation_type,
        'sku' => sprintf('AUTO-%s-%d', strtoupper($bundle), $nid),
        'status' => 0,
      ]);
      if ($price) {
        $variation->set('price', $price);
      }
      if ($capacity !== NULL && $variation->hasField('field_ticket_capacity')) {
        $variation->set('field_ticket_capacity', $capacity);
      }
      $variation->save();

      // Create product (unpublished until priced).
      $product = Product::create([
        'type' => $product_type,
        'title' => $node->label(),
        'status' => 0,
        'stores' => [['target_id' => 1]],
        'field_linked_page' => [['target_id' => $nid]],
      ]);
      $product->save();
      $product->addVariation($variation);
      $product->save();
    }

    // Update product fields to match node.
    $product->setTitle($node->label());
    if ($product->hasField('field_linked_page')) {
      $product->set('field_linked_page', [['target_id' => $nid]]);
    }

    // Update variation (first variation).
    $variations = $product->getVariations();
    $variation = $variations ? reset($variations) : NULL;
    if ($variation) {
      if ($price) {
        $variation->set('price', $price);
      }
      if ($capacity !== NULL && $variation->hasField('field_ticket_capacity')) {
        $variation->set('field_ticket_capacity', $capacity);
      }
      // Publish/unpublish ticket only if we have a price filled.
      if ($price) {
        $variation->set('status', $node->isPublished() ? 1 : 0);
      }
      $variation->save();
    }

    if ($price) {
      $product->set('status', $node->isPublished() ? 1 : 0);
    }
    $product->save();

    // Store reverse link on node if field exists and empty.
    if ($node->hasField('field_linked_ticket') && $node->get('field_linked_ticket')->isEmpty()) {
      $node->set('field_linked_ticket', $product->id());
      // Save quietly: recursion guard already set.
      $node->save();
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_structure')->error('Ticket autogen failed for node @nid: @msg', [
      '@nid' => $nid ?: '(new)',
      '@msg' => $e->getMessage(),
    ]);
  }
  finally {
    if ($nid) {
      unset($in_progress[$nid]);
    }
  }
}


/**
 * UNISONGES_COURSE_BOOKING_RIGHTS
 */
function unisonges_structure_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  _unisonges_structure_course_purchase_form_alter($form, $form_state, (string) $form_id);

  $webform = $form['#webform'] ?? NULL;
  if (!$webform || $webform->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $message = '';
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#access'] = FALSE;
    }
    $form['unisonges_booking_notice'] = [
      '#type' => 'markup',
      '#markup' => '<div class="messages messages--status" role="status" aria-live="polite"><div class="messages__content">Connectez-vous pour réserver un créneau.</div></div>',
      '#weight' => 999,
    ];
  }
  else {
    $account = \Drupal\user\Entity\User::load($current_user->id());
    if (!$account || !_unisonges_structure_user_can_book($account, $message)) {
      if (isset($form['actions']['submit'])) {
        $form['actions']['submit']['#access'] = FALSE;
      }
      $safe = htmlspecialchars($message ?: 'Vous ne pouvez pas réserver pour le moment.', ENT_QUOTES, 'UTF-8');
      $form['unisonges_booking_notice'] = [
        '#type' => 'markup',
        '#markup' => '<div class="messages messages--status" role="status" aria-live="polite"><div class="messages__content">' . $safe . '</div></div>',
        '#weight' => 999,
      ];
    }
  }

  $form['#validate'][] = 'unisonges_structure_booking_form_validate';
  _unisonges_structure_booking_form_ux_overrides($form);
}

/**
 * Builds the front reservation portal state for /reserver.
 */
function _unisonges_structure_build_reservation_portal_context(): array {
  $tunnel_url = _unisonges_structure_safe_route_url('unisonges_structure.reservation_course_tunnel', '/reservation-cours');
  $context = [
    'is_anonymous' => TRUE,
    'display_name' => '',
    'remaining' => NULL,
    'remaining_label' => 'Connectez-vous pour préparer votre réservation.',
    'expiry_label' => '',
    'status' => 'anonymous',
    'status_label' => 'Compte requis avant confirmation.',
    'message' => 'Les disponibilités restent consultables. Le paiement se décide après le choix du cours, du créneau et des détails.',
    'can_book' => FALSE,
    'login_url' => _unisonges_structure_safe_route_url('user.login', '/user/login', ['destination' => '/reservation-cours']),
    'register_url' => _unisonges_structure_safe_route_url('user.register', '/user/register', ['destination' => '/reservation-cours']),
    'tunnel_url' => $tunnel_url,
    'purchase_url' => '/cours',
    'purchase_label' => 'Voir les cours',
  ];

  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    return $context;
  }

  $context['is_anonymous'] = FALSE;
  $account = \Drupal\user\Entity\User::load($current_user->id());
  if (!$account) {
    $context['status'] = 'error';
    $context['status_label'] = 'Compte introuvable.';
    $context['message'] = 'Impossible de lire votre compte pour le moment.';
    return $context;
  }

  $remaining = $account->hasField('field_seances_restantes') ? max(0, (int) ($account->get('field_seances_restantes')->value ?? 0)) : 0;
  $to_pay_remaining = _unisonges_structure_count_available_to_pay_course_rights((int) $account->id());
  $message = '';
  $can_book = _unisonges_structure_user_can_book($account, $message);
  $expiry_value = $account->hasField('field_pack_expire_le') ? (string) ($account->get('field_pack_expire_le')->value ?? '') : '';

  $context['display_name'] = trim($account->getDisplayName());
  $context['remaining'] = $remaining;
  $context['remaining_label'] = $remaining <= 1 ? $remaining . ' séance disponible' : $remaining . ' séances disponibles';
  if ($to_pay_remaining > 0) {
    $to_pay_label = $to_pay_remaining === 1 ? '1 cours à payer disponible' : $to_pay_remaining . ' cours à payer disponibles';
    $context['remaining_label'] = $remaining > 0 ? $context['remaining_label'] . ' + ' . $to_pay_label : $to_pay_label;
  }
  $context['can_book'] = $can_book;
  $context['expiry_label'] = _unisonges_structure_format_course_pack_expiry($expiry_value);

  if ($can_book) {
    $context['status'] = 'ready';
    $context['status_label'] = 'Vous pouvez réserver un créneau.';
    $context['message'] = 'Choisissez une disponibilité, puis complétez les informations du cours.';
  }
  else {
    $context['status'] = 'blocked';
    $context['status_label'] = 'Paiement à choisir avant confirmation.';
    $context['message'] = $message ?: 'Vous pouvez consulter les créneaux. La confirmation se finalise après les détails et le choix du paiement.';
  }

  return $context;
}

/**
 * Builds the course reservation webform render array.
 */
function _unisonges_structure_build_course_reservation_form(): array {
  try {
    if (!\Drupal::moduleHandler()->moduleExists('webform')) {
      return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation est indisponible pour le moment.');
    }

    $webform = \Drupal::entityTypeManager()->getStorage('webform')->load('cours_particuliers_reservation');
    if (!$webform) {
      return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation est introuvable.');
    }

    if (method_exists($webform, 'getSubmissionForm')) {
      return $webform->getSubmissionForm();
    }

    if (class_exists('Drupal\webform\Entity\WebformSubmission')) {
      $submission = \Drupal\webform\Entity\WebformSubmission::create([
        'webform_id' => $webform->id(),
      ]);
      return \Drupal::service('entity.form_builder')->getForm($submission);
    }
  }
  catch (\Drupal\Core\Form\FormAjaxException $e) {
    throw $e;
  }
  catch (\Drupal\Core\Form\EnforcedResponseException $e) {
    throw $e;
  }
  catch (\Throwable $e) {
    $exception_class = get_class($e);
    \Drupal::logger('unisonges_structure')->error('Reservation portal webform build failed: @exception: @message', [
      '@exception' => $exception_class,
      '@message' => $e->getMessage() ?: $exception_class,
    ]);
  }

  return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation ne peut pas être affiché pour le moment.');
}

/**
 * Builds a small portal notice render array.
 */
function _unisonges_structure_reservation_portal_notice(string $message): array {
  return [
    '#type' => 'markup',
    '#markup' => '<p class="reservation-portal__notice">' . htmlspecialchars($message, ENT_QUOTES, 'UTF-8') . '</p>',
  ];
}

/**
 * Formats the course pack expiry date for the front portal.
 */
function _unisonges_structure_format_course_pack_expiry(string $value): string {
  if ($value === '') {
    return '';
  }

  try {
    $date = new \DateTimeImmutable($value);
  }
  catch (\Throwable $e) {
    return '';
  }

  $today = new \DateTimeImmutable('today');
  $label = $date->format('d/m/Y');
  if ($date < $today) {
    return 'Validité échue le ' . $label;
  }

  return 'Valable jusqu’au ' . $label;
}

/**
 * Builds a route URL with a static fallback.
 */
function _unisonges_structure_safe_route_url(string $route_name, string $fallback, array $query = []): string {
  try {
    return Url::fromRoute($route_name, [], ['query' => $query])->toString();
  }
  catch (\Throwable $e) {
    if (!$query) {
      return $fallback;
    }

    return $fallback . '?' . http_build_query($query);
  }
}

function _unisonges_structure_course_purchase_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (_unisonges_structure_is_add_to_cart_form($form_state, $form_id)) {
    _unisonges_structure_trial_add_to_cart_form_alter($form, $form_state);
  }

  if (_unisonges_structure_is_cart_form($form, $form_id)) {
    _unisonges_structure_course_cart_form_alter($form, $form_state);
  }

  if (_unisonges_structure_is_checkout_form($form_state, $form_id)) {
    $order = _unisonges_structure_get_form_order($form, $form_state);
    if ($order && _unisonges_structure_order_has_course_products($order)) {
      if (_unisonges_structure_limit_trial_items_on_order($order)) {
        $order->save();
        _unisonges_structure_add_trial_quantity_limit_status();
      }
      _unisonges_structure_checkout_form_ux_overrides($form, $form_state, $order);
    }
  }
}

function _unisonges_structure_is_add_to_cart_form(FormStateInterface $form_state, string $form_id): bool {
  if (strpos($form_id, 'commerce_order_item_') === 0 && strpos($form_id, '_add_to_cart_') !== FALSE && str_ends_with($form_id, '_form')) {
    return TRUE;
  }

  $form_object = $form_state->getFormObject();
  return $form_object && get_class($form_object) === 'Drupal\commerce_cart\Form\AddToCartForm';
}

function _unisonges_structure_trial_add_to_cart_form_alter(array &$form, FormStateInterface $form_state): void {
  $order_item = _unisonges_structure_get_form_order_item($form_state);
  if (!$order_item || _unisonges_structure_order_item_product_bundle($order_item) !== 'cours_essai') {
    return;
  }

  _unisonges_structure_limit_trial_quantity_widgets($form);

  $form['unisonges_trial_quantity_notice'] = [
    '#type' => 'markup',
    '#markup' => '<p class="unisonges-trial-limit-note">Le cours d’essai est limité à une seule séance par élève.</p>',
    '#weight' => 30,
  ];

  if (isset($form['actions']['submit']['#submit']) && is_array($form['actions']['submit']['#submit'])) {
    _unisonges_structure_append_form_callback($form['actions']['submit']['#submit'], 'unisonges_structure_trial_add_to_cart_submit');
  }
}

function _unisonges_structure_add_trial_quantity_limit_status(): void {
  \Drupal::messenger()->addStatus('Le cours d’essai est limité à une seule séance. La quantité a été ramenée à 1.');
}

function unisonges_structure_trial_add_to_cart_submit(array &$form, FormStateInterface $form_state): void {
  $order = NULL;
  $cart_id = (int) $form_state->get('cart_id');
  if ($cart_id > 0) {
    $order = \Drupal::entityTypeManager()->getStorage('commerce_order')->load($cart_id);
  }

  if (!$order) {
    $order_item = _unisonges_structure_get_form_order_item($form_state);
    if ($order_item && method_exists($order_item, 'getOrder')) {
      $order = $order_item->getOrder();
    }
  }

  if (!$order || !_unisonges_structure_limit_trial_items_on_order($order)) {
    return;
  }

  $order->save();
  _unisonges_structure_add_trial_quantity_limit_status();
}

function _unisonges_structure_get_form_order_item(FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return NULL;
  }

  $entity = $form_object->getEntity();
  if ($entity instanceof \Drupal\commerce_order\Entity\OrderItemInterface) {
    return $entity;
  }

  return NULL;
}

function _unisonges_structure_is_cart_form(array $form, string $form_id): bool {
  if (strpos($form_id, 'views_form_commerce_cart_form') === 0) {
    return TRUE;
  }

  $view = $form['#view'] ?? NULL;
  return is_object($view) && method_exists($view, 'id') && $view->id() === 'commerce_cart_form';
}

function _unisonges_structure_course_cart_form_alter(array &$form, FormStateInterface $form_state): void {
  $order = _unisonges_structure_get_cart_form_order($form);
  if ($order && _unisonges_structure_limit_trial_items_on_order($order)) {
    $order->save();
    _unisonges_structure_add_trial_quantity_limit_status();
  }

  $trial_rows = _unisonges_structure_cart_trial_row_indexes($form);
  if (!$trial_rows) {
    return;
  }

  foreach (array_keys($trial_rows) as $row_index) {
    _unisonges_structure_limit_cart_quantity_element($form, $form_state, $row_index);
  }

  if (!isset($form['#validate']) || !is_array($form['#validate'])) {
    $form['#validate'] = [];
  }
  _unisonges_structure_append_form_callback($form['#validate'], 'unisonges_structure_course_cart_quantity_validate');
}

function unisonges_structure_course_cart_quantity_validate(array &$form, FormStateInterface $form_state): void {
  $trial_rows = _unisonges_structure_cart_trial_row_indexes($form);
  foreach (array_keys($trial_rows) as $row_index) {
    foreach (['edit_quantity', 'quantity'] as $field_name) {
      $values = $form_state->getValue($field_name);
      if (!is_array($values) || !array_key_exists($row_index, $values)) {
        continue;
      }

      if ((float) $values[$row_index] !== 1.0) {
        $values[$row_index] = '1';
        $form_state->setValue($field_name, $values);
      }
    }
  }
}

function _unisonges_structure_cart_trial_row_indexes(array $form): array {
  $rows = [];
  $view = $form['#view'] ?? NULL;
  if (!is_object($view) || empty($view->result) || !is_iterable($view->result)) {
    return $rows;
  }

  foreach ($view->result as $row_index => $row) {
    $order_item = _unisonges_structure_get_order_item_from_view_row($row);
    if ($order_item && _unisonges_structure_order_item_product_bundle($order_item) === 'cours_essai') {
      $rows[$row_index] = TRUE;
    }
  }

  return $rows;
}

function _unisonges_structure_get_cart_form_order(array $form) {
  $view = $form['#view'] ?? NULL;
  if (!is_object($view) || empty($view->result) || !is_iterable($view->result)) {
    return NULL;
  }

  foreach ($view->result as $row) {
    $order_item = _unisonges_structure_get_order_item_from_view_row($row);
    if ($order_item && method_exists($order_item, 'getOrder')) {
      $order = $order_item->getOrder();
      if ($order instanceof \Drupal\commerce_order\Entity\OrderInterface) {
        return $order;
      }
    }
  }

  return NULL;
}

function _unisonges_structure_get_order_item_from_view_row($row) {
  $candidates = [];
  if (isset($row->_relationship_entities) && is_array($row->_relationship_entities)) {
    $candidates = array_merge($candidates, $row->_relationship_entities);
  }
  foreach (['_entity', '_object'] as $property) {
    if (isset($row->{$property})) {
      $candidates[] = $row->{$property};
    }
  }

  foreach ($candidates as $candidate) {
    if ($candidate instanceof \Drupal\commerce_order\Entity\OrderItemInterface) {
      return $candidate;
    }
  }

  return NULL;
}

function _unisonges_structure_limit_cart_quantity_element(array &$form, FormStateInterface $form_state, $row_index): void {
  foreach (['edit_quantity', 'quantity'] as $field_name) {
    if (isset($form[$field_name][$row_index]) && is_array($form[$field_name][$row_index])) {
      _unisonges_structure_apply_trial_quantity_limit($form[$field_name][$row_index]);
      _unisonges_structure_set_cart_quantity_form_value($form_state, $field_name, $row_index);
    }
  }
}

function _unisonges_structure_set_cart_quantity_form_value(FormStateInterface $form_state, string $field_name, $row_index): void {
  $values = $form_state->getValue($field_name);
  if (is_array($values) && array_key_exists($row_index, $values) && (float) $values[$row_index] !== 1.0) {
    $values[$row_index] = '1';
    $form_state->setValue($field_name, $values);
  }

  $input = $form_state->getUserInput();
  if (isset($input[$field_name]) && is_array($input[$field_name]) && array_key_exists($row_index, $input[$field_name]) && (float) $input[$field_name][$row_index] !== 1.0) {
    $input[$field_name][$row_index] = '1';
    $form_state->setUserInput($input);
  }
}

function _unisonges_structure_limit_trial_quantity_widgets(array &$element): void {
  if (isset($element['#parents'], $element['#type']) && is_array($element['#parents']) && in_array('quantity', $element['#parents'], TRUE)) {
    _unisonges_structure_apply_trial_quantity_limit($element);
  }

  foreach ($element as &$child) {
    if (is_array($child)) {
      _unisonges_structure_limit_trial_quantity_widgets($child);
    }
  }
  unset($child);
}

function _unisonges_structure_apply_trial_quantity_limit(array &$element): void {
  $element['#default_value'] = '1';
  $element['#value'] = '1';
  $element['#min'] = 1;
  $element['#max'] = 1;
  $element['#step'] = 1;
  if (!isset($element['#attributes']) || !is_array($element['#attributes'])) {
    $element['#attributes'] = [];
  }
  unset($element['#attributes']['value']);
  $element['#attributes']['readonly'] = 'readonly';
  $element['#attributes']['aria-label'] = 'Quantité limitée à 1 pour le cours d’essai';
  _unisonges_structure_append_element_description($element, 'Le cours d’essai est limité à 1.');
}

function _unisonges_structure_append_element_description(array &$element, string $message): void {
  if (empty($element['#description'])) {
    $element['#description'] = $message;
    return;
  }

  if (is_string($element['#description']) && strpos($element['#description'], $message) === FALSE) {
    $element['#description'] .= ' ' . $message;
  }
}

function _unisonges_structure_is_checkout_form(FormStateInterface $form_state, string $form_id): bool {
  if (strpos($form_id, 'commerce_checkout_flow_') === 0) {
    return TRUE;
  }

  $form_object = $form_state->getFormObject();
  return $form_object && str_starts_with(get_class($form_object), 'Drupal\commerce_checkout\\');
}

function _unisonges_structure_get_form_order(array $form, FormStateInterface $form_state) {
  foreach (['#commerce_order', '#order'] as $key) {
    if (isset($form[$key]) && $form[$key] instanceof \Drupal\commerce_order\Entity\OrderInterface) {
      return $form[$key];
    }
  }

  $form_object = $form_state->getFormObject();
  if ($form_object) {
    foreach (['getOrder', 'getEntity'] as $method) {
      if (!method_exists($form_object, $method)) {
        continue;
      }
      $entity = $form_object->{$method}();
      if ($entity instanceof \Drupal\commerce_order\Entity\OrderInterface) {
        return $entity;
      }
    }
  }

  return NULL;
}

function _unisonges_structure_checkout_form_ux_overrides(array &$form, FormStateInterface $form_state, \Drupal\commerce_order\Entity\OrderInterface $order): void {
  $step_id = _unisonges_structure_checkout_step_id($form, $form_state);
  if ($step_id === 'complete') {
    _unisonges_structure_replace_checkout_completion_message($form, _unisonges_structure_checkout_completion_text($order));
    $paid = method_exists($order, 'isPaid') && $order->isPaid();
    $form['unisonges_course_checkout_complete'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['messages', 'messages--status', 'unisonges-checkout-course-notice', 'unisonges-checkout-course-notice--complete']],
      '#weight' => -100,
      'message' => [
        '#markup' => '<div class="messages__content">' . _unisonges_structure_checkout_completion_text($order) . '</div>',
      ],
    ];
    if ($paid || _unisonges_structure_order_is_completed_pay_on_site_course_order($order)) {
      $form['unisonges_course_checkout_complete']['reserve'] = [
        '#type' => 'link',
        '#title' => 'Réserver un cours',
        '#url' => Url::fromUserInput('/reserver'),
        '#attributes' => ['class' => ['btn', 'btn--cta']],
      ];
    }
    return;
  }

  $form['unisonges_course_payment_notice'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['messages', 'messages--status', 'unisonges-checkout-course-notice']],
    '#weight' => -100,
    'message' => [
      '#markup' => '<div class="messages__content"><strong>Crédits et réservation.</strong> Paiement en ligne : vos crédits sont ouverts après confirmation du paiement. Paiement sur place : vous pouvez réserver dès la commande enregistrée ; le cours reste à payer sur place.</div>',
    ],
  ];
}

function _unisonges_structure_checkout_step_id(array $form, FormStateInterface $form_state): string {
  if (!empty($form['#step_id']) && is_scalar($form['#step_id'])) {
    return (string) $form['#step_id'];
  }

  foreach (['step_id', 'checkout_step'] as $key) {
    $value = $form_state->get($key);
    if (is_scalar($value) && $value !== '') {
      return (string) $value;
    }
  }

  $form_object = $form_state->getFormObject();
  if ($form_object) {
    foreach (['getStepId', 'getStep'] as $method) {
      if (method_exists($form_object, $method)) {
        $value = $form_object->{$method}();
        if (is_scalar($value) && $value !== '') {
          return (string) $value;
        }
      }
    }
  }

  return '';
}

function _unisonges_structure_replace_checkout_completion_message(array &$element, string $message): void {
  foreach (['#markup', '#plain_text', '#text'] as $property) {
    if (!isset($element[$property]) || !is_scalar($element[$property])) {
      continue;
    }
    $value = (string) $element[$property];
    if (strpos($value, 'Your order number') !== FALSE || strpos($value, 'You can view your order') !== FALSE) {
      $element[$property] = $message;
    }
  }

  foreach ($element as &$child) {
    if (is_array($child)) {
      _unisonges_structure_replace_checkout_completion_message($child, $message);
    }
  }
  unset($child);
}

function _unisonges_structure_checkout_completion_text(\Drupal\commerce_order\Entity\OrderInterface $order): string {
  $order_number = method_exists($order, 'getOrderNumber') ? trim((string) $order->getOrderNumber()) : '';
  $prefix = $order_number !== '' ? 'Commande ' . htmlspecialchars($order_number, ENT_QUOTES, 'UTF-8') . ' confirmée. ' : 'Commande confirmée. ';

  if (method_exists($order, 'isPaid') && $order->isPaid()) {
    return $prefix . 'Votre paiement est validé et vos crédits de cours sont disponibles. Vous pouvez maintenant choisir un créneau.';
  }

  if (_unisonges_structure_order_is_completed_pay_on_site_course_order($order)) {
    return $prefix . 'Votre commande avec paiement sur place est enregistrée. Vous pouvez réserver un créneau maintenant ; le cours restera indiqué comme cours à payer jusqu’à validation du paiement par l’équipe.';
  }

  return $prefix . 'Votre commande est enregistrée. Vos crédits et le droit de réserver seront ouverts après validation du paiement par l’équipe.';
}

function _unisonges_structure_order_has_course_products(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  foreach ($order->getItems() as $order_item) {
    if (in_array(_unisonges_structure_order_item_product_bundle($order_item), _unisonges_structure_course_product_bundles(), TRUE)) {
      return TRUE;
    }
  }

  return FALSE;
}

function _unisonges_structure_limit_trial_items_on_order(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  if (!_unisonges_structure_order_can_be_adjusted($order)) {
    return FALSE;
  }

  $changed = FALSE;
  foreach ($order->getItems() as $order_item) {
    if (_unisonges_structure_order_item_product_bundle($order_item) !== 'cours_essai') {
      continue;
    }
    if ((float) $order_item->getQuantity() <= 1.0) {
      continue;
    }

    $order_item->setQuantity('1');
    $order_item->save();
    $changed = TRUE;
  }

  if ($changed && defined('\Drupal\commerce_order\Entity\OrderInterface::REFRESH_ON_SAVE') && method_exists($order, 'setRefreshState')) {
    $order->setRefreshState(\Drupal\commerce_order\Entity\OrderInterface::REFRESH_ON_SAVE);
  }

  return $changed;
}

function _unisonges_structure_order_can_be_adjusted(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  if (!method_exists($order, 'getState')) {
    return TRUE;
  }

  $state = (string) ($order->getState()->value ?? '');
  return $state === '' || in_array($state, ['draft', 'cart'], TRUE);
}

function _unisonges_structure_order_item_product_bundle($order_item): string {
  if (!$order_item || !method_exists($order_item, 'getPurchasedEntity')) {
    return '';
  }

  $variation = $order_item->getPurchasedEntity();
  if (!$variation) {
    return '';
  }

  if (method_exists($variation, 'getProduct')) {
    $product = $variation->getProduct();
    if ($product && method_exists($product, 'bundle')) {
      return (string) $product->bundle();
    }
  }

  if (method_exists($variation, 'bundle')) {
    return (string) $variation->bundle();
  }

  return '';
}

function _unisonges_structure_course_product_bundles(): array {
  return ['cours_essai', 'cours_deb_inter', 'cours_avance', 'pack_4_deb_inter'];
}

function _unisonges_structure_append_form_callback(array &$callbacks, string $callback): void {
  if (!in_array($callback, $callbacks, TRUE)) {
    $callbacks[] = $callback;
  }
}



function _unisonges_structure_booking_form_ux_overrides(array &$form): void {
  foreach (['reservation', 'elements'] as $key) {
    if ($key === 'reservation' && isset($form['reservation']) && is_array($form['reservation'])) {
      $form['reservation']['#required_error'] = 'Choisissez un créneau.';
    }
    if ($key === 'elements' && isset($form['elements']['reservation']) && is_array($form['elements']['reservation'])) {
      $form['elements']['reservation']['#required_error'] = 'Choisissez un créneau.';
    }
  }

  _unisonges_structure_remove_already_submitted_notice($form);
}

function _unisonges_structure_remove_already_submitted_notice(array &$element): void {
  $needles = [
    'You have already submitted this webform.',
    'View your previous submission.',
  ];

  foreach (array_keys($element) as $key) {
    if (!is_array($element[$key])) {
      continue;
    }

    $matched = FALSE;
    foreach (['#markup', '#plain_text', '#title', '#description'] as $prop) {
      if (!isset($element[$key][$prop]) || !is_string($element[$key][$prop])) {
        continue;
      }

      $value = html_entity_decode(strip_tags($element[$key][$prop]), ENT_QUOTES, 'UTF-8');
      foreach ($needles as $needle) {
        if (strpos($value, $needle) !== FALSE) {
          $matched = TRUE;
          break 2;
        }
      }
    }

    if ($matched) {
      unset($element[$key]);
      continue;
    }

    _unisonges_structure_remove_already_submitted_notice($element[$key]);
  }
}

function unisonges_structure_booking_form_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $webform = $form['#webform'] ?? NULL;
  if (!$webform || $webform->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    $form_state->setErrorByName('reservation', 'Connectez-vous pour réserver un créneau.');
    return;
  }

  $account = \Drupal\user\Entity\User::load($current_user->id());
  $message = '';
  if (!$account || !_unisonges_structure_user_can_book($account, $message)) {
    $form_state->setErrorByName('reservation', $message ?: 'Vous ne pouvez pas réserver pour le moment.');
    return;
  }

  if ($form_state->getErrors()) {
    return;
  }

  $booking_value = $form_state->getValue('reservation');
  if ($booking_value === NULL) {
    $booking_value = $form_state->getValue(['elements', 'reservation']);
  }

  $booking = _unisonges_structure_parse_booking_form_value($booking_value);
  if ($booking['error'] !== '') {
    $form_state->setErrorByName('reservation', $booking['error']);
    return;
  }

  if ($booking['slot'] === '') {
    return;
  }

  $capacity = _unisonges_structure_get_booking_form_capacity($form);
  if ($booking['seats'] > $capacity['max_seats_per_booking']) {
    $form_state->setErrorByName('reservation', 'Le nombre de places demandé dépasse le maximum autorisé pour une réservation.');
    return;
  }

  if (!_unisonges_structure_acquire_booking_slot_lock($booking['slot'])) {
    $form_state->setErrorByName('reservation', 'Ce créneau est en cours de réservation. Réessayez dans quelques secondes.');
    return;
  }

  try {
    $exclude_sid = _unisonges_structure_get_form_submission_id($form_state);
    $conflict_message = _unisonges_structure_get_booking_conflict_message($booking['slot'], $booking['seats'], (int) $current_user->id(), $capacity['seats_slot'], $exclude_sid);
  }
  catch (\Throwable $e) {
    _unisonges_structure_release_booking_slot_lock($booking['slot']);
    \Drupal::logger('unisonges_structure')->error('Reservation slot conflict validation failed: @message', [
      '@message' => $e->getMessage(),
    ]);
    $form_state->setErrorByName('reservation', 'Impossible de vérifier ce créneau pour le moment. Réessayez dans quelques instants.');
    return;
  }

  if ($conflict_message !== '') {
    _unisonges_structure_release_booking_slot_lock($booking['slot']);
    $form_state->setErrorByName('reservation', $conflict_message);
    return;
  }
}

function _unisonges_structure_user_can_book(\Drupal\user\UserInterface $account, ?string &$message = ''): bool {
  if (!$account->hasField('field_seances_restantes')) {
    $message = 'Impossible de lire vos droits de cours pour le moment.';
    return FALSE;
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  $has_to_pay_right = _unisonges_structure_count_available_to_pay_course_rights((int) $account->id()) > 0;
  $paid_credit_blocked_message = '';
  $expiry_value = $account->hasField('field_pack_expire_le') ? ($account->get('field_pack_expire_le')->value ?? '') : '';
  $paid_credit_available = $remaining > 0;
  if ($paid_credit_available && $expiry_value) {
    try {
      $today = new \DateTimeImmutable('today');
      $expiry = new \DateTimeImmutable($expiry_value);
    }
    catch (\Throwable $e) {
      if ($has_to_pay_right) {
        return TRUE;
      }
      $message = 'Impossible de lire la validité de vos droits de cours pour le moment.';
      return FALSE;
    }
    if ($expiry < $today) {
      $paid_credit_available = FALSE;
      $paid_credit_blocked_message = 'Votre validité précédente est échue. Choisissez le cours, le créneau, les détails, puis le paiement pour confirmer.';
    }
  }

  if ($paid_credit_available || $has_to_pay_right) {
    return TRUE;
  }

  $message = $paid_credit_blocked_message ?: 'Choisissez le cours, le créneau, les détails, puis le paiement pour confirmer la réservation.';
  return FALSE;
}

function _unisonges_structure_parse_booking_form_value($value): array {
  $booking = [
    'slot' => '',
    'seats' => 0,
    'error' => '',
  ];

  if (is_array($value)) {
    $slot = trim((string) ($value['slot'] ?? ''));
    if ($slot === '') {
      return $booking;
    }

    $date = \DateTimeImmutable::createFromFormat('!Y-m-d H:i', $slot);
    if (!$date || $date->format('Y-m-d H:i') !== $slot) {
      $booking['error'] = 'Le créneau sélectionné est invalide.';
      return $booking;
    }

    $seats_value = $value['seats'] ?? 1;
    if (!is_numeric($seats_value) || (int) $seats_value <= 0) {
      $booking['error'] = 'Le nombre de places demandé est invalide.';
      return $booking;
    }

    $booking['slot'] = $slot;
    $booking['seats'] = (int) $seats_value;
    return $booking;
  }

  if (is_string($value) && trim($value) !== '') {
    $parsed = unisonges_structure_parse_booking_reservation_value($value);
    if ($parsed === NULL || !empty($parsed['cancelled'])) {
      $booking['error'] = 'Le créneau sélectionné est invalide.';
      return $booking;
    }

    $booking['slot'] = $parsed['date'] . ' ' . $parsed['time'];
    $booking['seats'] = max(1, (int) $parsed['seats']);
  }

  return $booking;
}

function _unisonges_structure_get_booking_form_capacity(array $form): array {
  $element = [];
  if (isset($form['reservation']) && is_array($form['reservation'])) {
    $element = $form['reservation'];
  }
  elseif (isset($form['elements']['reservation']) && is_array($form['elements']['reservation'])) {
    $element = $form['elements']['reservation'];
  }

  $seats_slot = max(1, (int) ($element['#seats_slot'] ?? 1));
  $max_seats_per_booking = max(1, (int) ($element['#max_seats_per_booking'] ?? 1));

  return [
    'seats_slot' => $seats_slot,
    'max_seats_per_booking' => min($max_seats_per_booking, $seats_slot),
  ];
}

function _unisonges_structure_get_form_submission_id(\Drupal\Core\Form\FormStateInterface $form_state): int {
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return 0;
  }

  $entity = $form_object->getEntity();
  if ($entity instanceof \Drupal\webform\WebformSubmissionInterface) {
    return (int) $entity->id();
  }

  return 0;
}

function _unisonges_structure_acquire_booking_slot_lock(string $slot): bool {
  if (!\Drupal::lock()->acquire(_unisonges_structure_booking_slot_lock_id($slot), 30.0)) {
    return FALSE;
  }

  register_shutdown_function('_unisonges_structure_release_booking_slot_lock', $slot);
  return TRUE;
}

function _unisonges_structure_release_booking_slot_lock(string $slot): void {
  $slot = trim($slot);
  if ($slot === '') {
    return;
  }

  \Drupal::lock()->release(_unisonges_structure_booking_slot_lock_id($slot));
}

function _unisonges_structure_release_booking_slot_lock_from_submission(\Drupal\webform\WebformSubmissionInterface $webform_submission): void {
  $reservation = unisonges_structure_parse_booking_reservation_value(
    _unisonges_structure_get_submission_element_string($webform_submission, 'reservation')
  );
  if ($reservation === NULL || !empty($reservation['cancelled'])) {
    return;
  }

  _unisonges_structure_release_booking_slot_lock($reservation['date'] . ' ' . $reservation['time']);
}

function _unisonges_structure_booking_slot_lock_id(string $slot): string {
  return 'unisonges_structure:booking_slot:' . hash('sha256', $slot);
}

function _unisonges_structure_get_booking_conflict_message(string $slot, int $requested_seats, int $uid, int $seats_slot, int $exclude_sid = 0): string {
  $usage = _unisonges_structure_load_booking_slot_usage($slot, $exclude_sid);
  if (isset($usage['user_ids'][$uid])) {
    return 'Vous avez déjà une réservation active sur ce créneau.';
  }

  if ($usage['booked_seats'] + $requested_seats > $seats_slot) {
    return 'Ce créneau vient d’être réservé. Choisissez un autre créneau.';
  }

  return '';
}

function _unisonges_structure_get_submission_booking_request(\Drupal\webform\WebformSubmissionInterface $webform_submission): ?array {
  $reservation = unisonges_structure_parse_booking_reservation_value(
    _unisonges_structure_get_submission_element_string($webform_submission, 'reservation')
  );
  if ($reservation === NULL || !empty($reservation['cancelled'])) {
    return NULL;
  }

  return [
    'slot' => $reservation['date'] . ' ' . $reservation['time'],
    'seats' => max(1, (int) $reservation['seats']),
  ];
}

function _unisonges_structure_get_submission_booking_conflict_message(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $booking = _unisonges_structure_get_submission_booking_request($webform_submission);
  $uid = (int) $webform_submission->getOwnerId();
  if ($booking === NULL || $uid <= 0) {
    return '';
  }

  $element = _unisonges_structure_get_webform_element_definition($webform_submission, 'reservation');
  $seats_slot = max(1, (int) ($element['#seats_slot'] ?? 1));

  return _unisonges_structure_get_booking_conflict_message(
    $booking['slot'],
    $booking['seats'],
    $uid,
    $seats_slot,
    (int) $webform_submission->id()
  );
}

function _unisonges_structure_build_inactive_booking_value(string $slot): string {
  return trim($slot) . '|0';
}

function _unisonges_structure_update_stored_submission_reservation(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $reservation_value): bool {
  $sid = (int) $webform_submission->id();
  if ($sid <= 0) {
    return FALSE;
  }

  try {
    $updated = \Drupal::database()->update('webform_submission_data')
      ->fields(['value' => $reservation_value])
      ->condition('webform_id', $webform_submission->getWebform()->id())
      ->condition('sid', $sid)
      ->condition('name', 'reservation')
      ->execute();
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_structure')->error('Reservation submission @sid could not update stored reservation fallback value: @message', [
      '@sid' => $sid,
      '@message' => $e->getMessage(),
    ]);
    return FALSE;
  }

  return $updated > 0;
}

function _unisonges_structure_load_booking_slot_usage(string $slot, int $exclude_sid = 0): array {
  $usage = [
    'booked_seats' => 0,
    'user_ids' => [],
  ];

  $database = \Drupal::database();
  $query = $database->select('webform_submission_data', 'wsd');
  $query->fields('wsd', ['sid', 'value']);
  $query->join('webform_submission', 'ws', 'ws.sid = wsd.sid');
  $query->addField('ws', 'uid');
  $query
    ->condition('wsd.webform_id', 'cours_particuliers_reservation')
    ->condition('wsd.name', 'reservation')
    ->condition('wsd.value', $database->escapeLike($slot) . '|%', 'LIKE');

  if ($exclude_sid > 0) {
    $query->condition('wsd.sid', $exclude_sid, '<>');
  }

  foreach ($query->execute()->fetchAll() as $row) {
    $seats = _unisonges_structure_get_booking_value_seats((string) $row->value, $slot);
    if ($seats <= 0) {
      continue;
    }

    $usage['booked_seats'] += $seats;
    $usage['user_ids'][(int) $row->uid] = TRUE;
  }

  return $usage;
}

function _unisonges_structure_get_booking_value_seats(string $value, string $expected_slot): int {
  $parsed = unisonges_structure_parse_booking_reservation_value($value);
  if ($parsed !== NULL) {
    $slot = $parsed['date'] . ' ' . $parsed['time'];
    if ($slot !== $expected_slot || !empty($parsed['cancelled'])) {
      return 0;
    }

    return max(0, (int) $parsed['seats']);
  }

  if (strpos($value, $expected_slot . '|') !== 0) {
    return 0;
  }

  $parts = explode('|', $value, 2);
  return max(0, (int) ($parts[1] ?? 1));
}

function _unisonges_structure_apply_course_rights_from_order(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  $state = (string) ($order->getState()->value ?? '');
  $is_pay_on_site = _unisonges_structure_order_uses_pay_on_site_payment($order);
  if ($state !== 'completed') {
    if ($is_pay_on_site && in_array($state, ['canceled', 'cancelled'], TRUE)) {
      _unisonges_structure_cancel_pending_to_pay_course_rights_from_order($order);
    }
    return;
  }

  if ($is_pay_on_site && !$order->isPaid()) {
    _unisonges_structure_ensure_to_pay_course_rights_from_order($order);
    return;
  }
  if (!$order->isPaid()) {
    return;
  }

  if ($order->getData('unisonges_course_rights_applied')) {
    return;
  }

  if ($is_pay_on_site && _unisonges_structure_order_has_to_pay_course_rights($order)) {
    _unisonges_structure_apply_paid_course_rights_from_to_pay_order($order);
    return;
  }

  $uid = (int) $order->getCustomerId();
  if (!$uid) {
    return;
  }

  $account = \Drupal\user\Entity\User::load($uid);
  if (!$account) {
    return;
  }

  foreach (['field_seances_restantes', 'field_essai_utilise', 'field_pack_expire_le'] as $field_name) {
    if (!$account->hasField($field_name)) {
      \Drupal::logger('unisonges_structure')->error('Course rights could not be applied for order @order and user @uid because user field @field is missing.', [
        '@order' => $order->id(),
        '@uid' => $uid,
        '@field' => $field_name,
      ]);
      return;
    }
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  $essai_utilise = (bool) ($account->get('field_essai_utilise')->value ?? FALSE);
  $expiry_value = $account->get('field_pack_expire_le')->value ?? '';
  $expiry = $expiry_value ? new \DateTimeImmutable($expiry_value) : NULL;
  $today = new \DateTimeImmutable('today');
  $changed = FALSE;
  $credits_added = 0;
  $pack_expiry_for_email = NULL;

  if ($expiry && $expiry < $today) {
    $remaining = 0;
    $expiry = NULL;
    $account->set('field_pack_expire_le', NULL);
    $changed = TRUE;
  }

  foreach ($order->getItems() as $order_item) {
    $quantity = (int) round((float) $order_item->getQuantity());
    if ($quantity < 1) {
      $quantity = 1;
    }

    $variation = $order_item->getPurchasedEntity();
    if (!$variation || !method_exists($variation, 'getProduct')) {
      continue;
    }
    $product = $variation->getProduct();
    if (!$product) {
      continue;
    }

    switch ($product->bundle()) {
      case 'cours_essai':
        if (!$essai_utilise) {
          $remaining += 1;
          $credits_added += 1;
          $essai_utilise = TRUE;
          $changed = TRUE;
        }
        break;
      case 'cours_deb_inter':
      case 'cours_avance':
        $remaining += $quantity;
        $credits_added += $quantity;
        $changed = TRUE;
        break;
      case 'pack_4_deb_inter':
        $added = 4 * $quantity;
        $remaining += $added;
        $credits_added += $added;
        $base = ($expiry && $expiry >= $today) ? $expiry : $today;
        $expiry = $base->modify('+6 months');
        $pack_expiry_for_email = $expiry;
        $changed = TRUE;
        break;
    }
  }

  if ($changed) {
    $account->set('field_seances_restantes', $remaining);
    $account->set('field_essai_utilise', $essai_utilise ? 1 : 0);
    if ($expiry) {
      $account->set('field_pack_expire_le', $expiry->format('Y-m-d'));
    }
    $account->save();
  }

  $order->setData('unisonges_course_rights_applied', TRUE);
  $order->save();

  if ($credits_added > 0) {
    _unisonges_structure_send_course_rights_applied_mail($order, $account, $credits_added, $remaining, $pack_expiry_for_email);
  }
}

function _unisonges_structure_send_course_rights_applied_mail(\Drupal\commerce_order\Entity\OrderInterface $order, \Drupal\user\UserInterface $account, int $credits_added, int $remaining, ?\DateTimeImmutable $pack_expiry): void {
  $to = trim((string) $order->getEmail());
  if ($to === '') {
    $to = trim((string) $account->getEmail());
  }

  if ($to === '' || !\Drupal::service('email.validator')->isValid($to)) {
    \Drupal::logger('unisonges_structure')->warning('Course rights email skipped for order @order and user @uid because no valid recipient email was available.', [
      '@order' => $order->id(),
      '@uid' => $account->id(),
    ]);
    return;
  }

  $site_name = trim((string) \Drupal::config('system.site')->get('name'));
  if ($site_name === '') {
    $site_name = 'Uni-Songes';
  }

  $lines = [
    'Bonjour,',
    '',
    'Votre paiement est validé et vos crédits de cours ont été ajoutés.',
    '',
    'Crédits ajoutés : ' . _unisonges_structure_format_course_credit_count($credits_added) . '.',
    'Crédits disponibles : ' . _unisonges_structure_format_course_credit_count($remaining) . '.',
  ];

  if ($pack_expiry instanceof \DateTimeImmutable) {
    $lines[] = 'Validité du pack : jusqu’au ' . $pack_expiry->format('d/m/Y') . '.';
  }

  $lines[] = '';
  $lines[] = 'Réserver un créneau : /reserver';
  $lines[] = '';
  $lines[] = 'À bientôt,';
  $lines[] = $site_name;

  $result = \Drupal::service('plugin.manager.mail')->mail(
    'unisonges_structure',
    'course_rights_applied',
    $to,
    $account->getPreferredLangcode(),
    [
      'subject' => 'Vos crédits de cours sont disponibles',
      'body' => implode("\n", $lines),
    ]
  );

  if (empty($result['result'])) {
    \Drupal::logger('unisonges_structure')->error('Course rights email failed for order @order and user @uid.', [
      '@order' => $order->id(),
      '@uid' => $account->id(),
    ]);
    return;
  }

  \Drupal::logger('unisonges_structure')->notice('Course rights email sent for order @order and user @uid.', [
    '@order' => $order->id(),
    '@uid' => $account->id(),
  ]);
}

function _unisonges_structure_format_course_credit_count(int $count): string {
  $count = max(0, $count);
  if ($count === 1) {
    return '1 crédit de cours';
  }

  return $count . ' crédits de cours';
}

function _unisonges_structure_order_is_completed_pay_on_site_course_order(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  return (string) ($order->getState()->value ?? '') === 'completed'
    && _unisonges_structure_order_uses_pay_on_site_payment($order)
    && _unisonges_structure_order_has_course_products($order);
}

function _unisonges_structure_order_uses_pay_on_site_payment(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  if (method_exists($order, 'hasField') && $order->hasField('payment_gateway') && !$order->get('payment_gateway')->isEmpty()) {
    $gateway_item = $order->get('payment_gateway')->first();
    $gateway = $gateway_item && isset($gateway_item->entity) ? $gateway_item->entity : NULL;
    if ($gateway && _unisonges_structure_payment_gateway_is_pay_on_site($gateway)) {
      return TRUE;
    }

    $gateway_id = $gateway_item ? (string) ($gateway_item->target_id ?? '') : '';
    if ($gateway_id !== '') {
      try {
        $gateway = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway')->load($gateway_id);
        if ($gateway && _unisonges_structure_payment_gateway_is_pay_on_site($gateway)) {
          return TRUE;
        }
      }
      catch (\Throwable $e) {
        // Fall through to the exact gateway-id fallback below.
      }
    }
    if ($gateway_id === 'manual') {
      return TRUE;
    }
  }

  $order_id = (int) $order->id();
  if ($order_id <= 0) {
    return FALSE;
  }

  try {
    $entity_type_manager = \Drupal::entityTypeManager();
    if (!$entity_type_manager->hasDefinition('commerce_payment')) {
      return FALSE;
    }

    $query = $entity_type_manager->getStorage('commerce_payment')->getQuery()->accessCheck(FALSE);
    try {
      $query->condition('order_id', $order_id);
      $payment_ids = $query->execute();
    }
    catch (\Throwable $e) {
      $query = $entity_type_manager->getStorage('commerce_payment')->getQuery()->accessCheck(FALSE);
      $query->condition('order_id.target_id', $order_id);
      $payment_ids = $query->execute();
    }

    if (!$payment_ids) {
      return FALSE;
    }

    foreach ($entity_type_manager->getStorage('commerce_payment')->loadMultiple($payment_ids) as $payment) {
      if (method_exists($payment, 'hasField') && $payment->hasField('payment_gateway') && !$payment->get('payment_gateway')->isEmpty()) {
        $gateway_item = $payment->get('payment_gateway')->first();
        $gateway = $gateway_item && isset($gateway_item->entity) ? $gateway_item->entity : NULL;
        if ($gateway && _unisonges_structure_payment_gateway_is_pay_on_site($gateway)) {
          return TRUE;
        }
        $gateway_id = $gateway_item ? (string) ($gateway_item->target_id ?? '') : '';
        if ($gateway_id === 'manual') {
          return TRUE;
        }
      }
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_structure')->warning('Could not inspect payments for order @order while detecting pay-on-site payment: @message', [
      '@order' => $order_id,
      '@message' => $e->getMessage(),
    ]);
  }

  return FALSE;
}

function _unisonges_structure_payment_gateway_is_pay_on_site($gateway): bool {
  if (is_object($gateway) && method_exists($gateway, 'getPluginId') && (string) $gateway->getPluginId() === 'manual') {
    return TRUE;
  }

  if (is_object($gateway) && method_exists($gateway, 'id') && (string) $gateway->id() === 'manual') {
    return TRUE;
  }

  return FALSE;
}

function _unisonges_structure_ensure_to_pay_course_rights_from_order(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  if (!_unisonges_structure_to_pay_rights_table_exists()) {
    _unisonges_structure_log_missing_to_pay_rights_table_once();
    return;
  }

  $order_id = (int) $order->id();
  $uid = (int) $order->getCustomerId();
  if ($order_id <= 0 || $uid <= 0) {
    return;
  }

  $account = \Drupal\user\Entity\User::load($uid);
  if (!$account) {
    return;
  }

  $now = \Drupal::time()->getRequestTime();
  $table = _unisonges_structure_to_pay_rights_table_name();
  $ensured = 0;

  foreach ($order->getItems() as $order_item) {
    $source_order_item_id = (int) $order_item->id();
    if ($source_order_item_id <= 0) {
      \Drupal::logger('unisonges_structure')->warning('Pay-on-site rights skipped for order @order because an order item has no saved ID.', [
        '@order' => $order_id,
      ]);
      continue;
    }

    $bundle = _unisonges_structure_order_item_product_bundle($order_item);
    $credit_count = _unisonges_structure_to_pay_credit_count_for_order_item($order_item, $account);
    for ($credit_index = 1; $credit_index <= $credit_count; $credit_index++) {
      \Drupal::database()->merge($table)
        ->keys([
          'order_id' => $order_id,
          'source_order_item_id' => $source_order_item_id,
          'credit_index' => $credit_index,
        ])
        ->insertFields([
          'order_id' => $order_id,
          'uid' => $uid,
          'source_order_item_id' => $source_order_item_id,
          'credit_index' => $credit_index,
          'product_bundle' => $bundle,
          'remaining_to_pay_credits' => 1,
          'webform_submission_id' => NULL,
          'status' => 'pending_payment',
          'created' => $now,
          'changed' => $now,
          'consumed' => NULL,
          'paid' => NULL,
          'cancelled' => NULL,
        ])
        ->updateFields([
          'uid' => $uid,
          'product_bundle' => $bundle,
        ])
        ->execute();
      $ensured++;
    }
  }

  if ($ensured > 0) {
    \Drupal::logger('unisonges_structure')->notice('Pay-on-site course rights ensured for unpaid manual order @order and user @uid (@count unit(s)).', [
      '@order' => $order_id,
      '@uid' => $uid,
      '@count' => $ensured,
    ]);
  }
}

function _unisonges_structure_to_pay_credit_count_for_order_item($order_item, \Drupal\user\UserInterface $account): int {
  $bundle = _unisonges_structure_order_item_product_bundle($order_item);
  if (!in_array($bundle, _unisonges_structure_course_product_bundles(), TRUE)) {
    return 0;
  }

  $quantity = (int) round((float) $order_item->getQuantity());
  if ($quantity < 1) {
    $quantity = 1;
  }

  switch ($bundle) {
    case 'cours_essai':
      if ($account->hasField('field_essai_utilise') && (bool) ($account->get('field_essai_utilise')->value ?? FALSE)) {
        return 0;
      }
      if (_unisonges_structure_user_has_active_to_pay_trial_right((int) $account->id())) {
        return 0;
      }
      return 1;

    case 'cours_deb_inter':
    case 'cours_avance':
      return $quantity;

    case 'pack_4_deb_inter':
      return 4 * $quantity;
  }

  return 0;
}

function _unisonges_structure_user_has_active_to_pay_trial_right(int $uid): bool {
  if ($uid <= 0 || !_unisonges_structure_to_pay_rights_table_exists()) {
    return FALSE;
  }

  return (bool) \Drupal::database()->select(_unisonges_structure_to_pay_rights_table_name(), 'r')
    ->condition('uid', $uid)
    ->condition('product_bundle', 'cours_essai')
    ->condition('status', ['pending_payment', 'consumed'], 'IN')
    ->countQuery()
    ->execute()
    ->fetchField();
}

function _unisonges_structure_cancel_pending_to_pay_course_rights_from_order(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  if (!_unisonges_structure_to_pay_rights_table_exists()) {
    return;
  }

  $order_id = (int) $order->id();
  if ($order_id <= 0) {
    return;
  }

  $now = \Drupal::time()->getRequestTime();
  \Drupal::database()->update(_unisonges_structure_to_pay_rights_table_name())
    ->fields([
      'status' => 'cancelled',
      'remaining_to_pay_credits' => 0,
      'changed' => $now,
      'cancelled' => $now,
    ])
    ->condition('order_id', $order_id)
    ->condition('status', 'pending_payment')
    ->execute();
}

function _unisonges_structure_order_has_to_pay_course_rights(\Drupal\commerce_order\Entity\OrderInterface $order): bool {
  if (!_unisonges_structure_to_pay_rights_table_exists()) {
    return FALSE;
  }

  $order_id = (int) $order->id();
  if ($order_id <= 0) {
    return FALSE;
  }

  return (bool) \Drupal::database()->select(_unisonges_structure_to_pay_rights_table_name(), 'r')
    ->condition('order_id', $order_id)
    ->countQuery()
    ->execute()
    ->fetchField();
}

function _unisonges_structure_apply_paid_course_rights_from_to_pay_order(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  if (!_unisonges_structure_to_pay_rights_table_exists()) {
    return;
  }

  $uid = (int) $order->getCustomerId();
  if ($uid <= 0) {
    return;
  }

  $account = \Drupal\user\Entity\User::load($uid);
  if (!$account) {
    return;
  }

  foreach (['field_seances_restantes', 'field_essai_utilise', 'field_pack_expire_le'] as $field_name) {
    if (!$account->hasField($field_name)) {
      \Drupal::logger('unisonges_structure')->error('Pay-on-site course rights could not be finalized for order @order and user @uid because user field @field is missing.', [
        '@order' => $order->id(),
        '@uid' => $uid,
        '@field' => $field_name,
      ]);
      return;
    }
  }

  $table = _unisonges_structure_to_pay_rights_table_name();
  $rows = \Drupal::database()->select($table, 'r')
    ->fields('r')
    ->condition('order_id', (int) $order->id())
    ->condition('status', ['pending_payment', 'consumed'], 'IN')
    ->orderBy('id', 'ASC')
    ->execute()
    ->fetchAll();

  if (!$rows) {
    return;
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  $essai_utilise = (bool) ($account->get('field_essai_utilise')->value ?? FALSE);
  $expiry_value = $account->get('field_pack_expire_le')->value ?? '';
  $expiry = $expiry_value ? new \DateTimeImmutable($expiry_value) : NULL;
  $today = new \DateTimeImmutable('today');
  $changed = FALSE;
  $credits_added = 0;
  $pack_expiry_for_email = NULL;
  $pack_items_to_extend = [];
  $pending_ids = [];
  $consumed_ids = [];
  $consumed_sids = [];

  if ($expiry && $expiry < $today) {
    $remaining = 0;
    $expiry = NULL;
    $account->set('field_pack_expire_le', NULL);
    $changed = TRUE;
  }

  foreach ($rows as $row) {
    $id = (int) $row->id;
    if ((string) $row->status === 'consumed') {
      $consumed_ids[] = $id;
      $sid = (int) ($row->webform_submission_id ?? 0);
      if ($sid > 0) {
        $consumed_sids[$sid] = TRUE;
      }
      continue;
    }

    if ((int) $row->remaining_to_pay_credits <= 0) {
      continue;
    }

    $pending_ids[] = $id;
    switch ((string) $row->product_bundle) {
      case 'cours_essai':
        if (!$essai_utilise) {
          $remaining += 1;
          $credits_added += 1;
          $essai_utilise = TRUE;
          $changed = TRUE;
        }
        break;

      case 'cours_deb_inter':
      case 'cours_avance':
        $remaining += 1;
        $credits_added += 1;
        $changed = TRUE;
        break;

      case 'pack_4_deb_inter':
        $remaining += 1;
        $credits_added += 1;
        $pack_items_to_extend[(int) $row->source_order_item_id] = TRUE;
        $changed = TRUE;
        break;
    }
  }

  foreach (array_keys($pack_items_to_extend) as $source_order_item_id) {
    $base = ($expiry && $expiry >= $today) ? $expiry : $today;
    $expiry = $base->modify('+6 months');
    $pack_expiry_for_email = $expiry;
  }

  if ($changed) {
    $account->set('field_seances_restantes', $remaining);
    $account->set('field_essai_utilise', $essai_utilise ? 1 : 0);
    if ($expiry) {
      $account->set('field_pack_expire_le', $expiry->format('Y-m-d'));
    }
    $account->save();
  }

  $now = \Drupal::time()->getRequestTime();
  $paid_ids = array_merge($pending_ids, $consumed_ids);
  if ($paid_ids) {
    \Drupal::database()->update($table)
      ->fields([
        'status' => 'paid',
        'remaining_to_pay_credits' => 0,
        'changed' => $now,
        'paid' => $now,
      ])
      ->condition('id', $paid_ids, 'IN')
      ->execute();
  }

  $order->setData('unisonges_course_rights_applied', TRUE);
  $order->save();

  foreach (array_keys($consumed_sids) as $sid) {
    $submission = \Drupal::entityTypeManager()->getStorage('webform_submission')->load((int) $sid);
    if ($submission instanceof \Drupal\webform\WebformSubmissionInterface) {
      _unisonges_structure_queue_google_calendar_booking_sync($submission, 'pending_update');
    }
  }

  \Drupal::logger('unisonges_structure')->notice('Pay-on-site order @order payment finalized for user @uid: @added paid credit(s) added, @consumed consumed reservation(s) kept without duplicate credit.', [
    '@order' => $order->id(),
    '@uid' => $uid,
    '@added' => $credits_added,
    '@consumed' => count($consumed_ids),
  ]);

  if ($credits_added > 0) {
    _unisonges_structure_send_course_rights_applied_mail($order, $account, $credits_added, $remaining, $pack_expiry_for_email);
  }
}

function _unisonges_structure_count_available_to_pay_course_rights(int $uid): int {
  if ($uid <= 0 || !_unisonges_structure_to_pay_rights_table_exists()) {
    return 0;
  }

  return (int) \Drupal::database()->select(_unisonges_structure_to_pay_rights_table_name(), 'r')
    ->condition('uid', $uid)
    ->condition('status', 'pending_payment')
    ->condition('remaining_to_pay_credits', 0, '>')
    ->countQuery()
    ->execute()
    ->fetchField();
}

function _unisonges_structure_consume_booking_right(\Drupal\user\UserInterface $account, \Drupal\webform\WebformSubmissionInterface $webform_submission): array {
  $preferred_to_pay_order_id = _unisonges_structure_get_preferred_to_pay_order_id($webform_submission);
  if ($preferred_to_pay_order_id > 0) {
    return _unisonges_structure_consume_to_pay_booking_right($account, $webform_submission, $preferred_to_pay_order_id);
  }

  if (_unisonges_structure_user_has_valid_paid_credit($account)) {
    return _unisonges_structure_consume_paid_booking_credit($account);
  }

  return _unisonges_structure_consume_to_pay_booking_right($account, $webform_submission);
}

function _unisonges_structure_get_preferred_to_pay_order_id(\Drupal\webform\WebformSubmissionInterface $webform_submission): int {
  if (_unisonges_structure_get_submission_element_string($webform_submission, 'unisonges_payment_choice') !== 'pay_on_site') {
    return 0;
  }

  return max(0, (int) _unisonges_structure_get_submission_element_string($webform_submission, 'unisonges_pay_on_site_order_id'));
}

function _unisonges_structure_user_has_valid_paid_credit(\Drupal\user\UserInterface $account): bool {
  if (!$account->hasField('field_seances_restantes')) {
    return FALSE;
  }

  if ((int) ($account->get('field_seances_restantes')->value ?? 0) <= 0) {
    return FALSE;
  }

  $expiry_value = $account->hasField('field_pack_expire_le') ? (string) ($account->get('field_pack_expire_le')->value ?? '') : '';
  if ($expiry_value === '') {
    return TRUE;
  }

  try {
    $today = new \DateTimeImmutable('today');
    $expiry = new \DateTimeImmutable($expiry_value);
  }
  catch (\Throwable $e) {
    return FALSE;
  }

  return $expiry >= $today;
}

function _unisonges_structure_consume_paid_booking_credit(\Drupal\user\UserInterface $account): array {
  $remaining = max(0, (int) ($account->get('field_seances_restantes')->value ?? 0) - 1);
  $account->set('field_seances_restantes', $remaining);

  if ($remaining === 0 && $account->hasField('field_pack_expire_le') && !$account->get('field_pack_expire_le')->isEmpty()) {
    $account->set('field_pack_expire_le', NULL);
  }

  $account->save();

  return [
    'type' => 'paid_credit',
    'right_id' => 0,
  ];
}

function _unisonges_structure_consume_to_pay_booking_right(\Drupal\user\UserInterface $account, \Drupal\webform\WebformSubmissionInterface $webform_submission, int $preferred_order_id = 0): array {
  $uid = (int) $account->id();
  $sid = (int) $webform_submission->id();
  if ($uid <= 0 || $sid <= 0 || !_unisonges_structure_to_pay_rights_table_exists()) {
    return ['type' => '', 'right_id' => 0];
  }

  $table = _unisonges_structure_to_pay_rights_table_name();
  $query = \Drupal::database()->select($table, 'r')
    ->fields('r')
    ->condition('uid', $uid)
    ->condition('status', 'pending_payment')
    ->condition('remaining_to_pay_credits', 0, '>');
  if ($preferred_order_id > 0) {
    $query->condition('order_id', $preferred_order_id);
  }
  $row = $query
    ->orderBy('created', 'ASC')
    ->orderBy('id', 'ASC')
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  if (!$row) {
    return ['type' => '', 'right_id' => 0];
  }

  $now = \Drupal::time()->getRequestTime();
  $updated = \Drupal::database()->update($table)
    ->fields([
      'status' => 'consumed',
      'remaining_to_pay_credits' => 0,
      'webform_submission_id' => $sid,
      'changed' => $now,
      'consumed' => $now,
    ])
    ->condition('id', (int) $row->id)
    ->condition('status', 'pending_payment')
    ->condition('remaining_to_pay_credits', 0, '>')
    ->execute();

  if ($updated <= 0) {
    return ['type' => '', 'right_id' => 0];
  }

  if ((string) $row->product_bundle === 'cours_essai' && $account->hasField('field_essai_utilise') && !(bool) ($account->get('field_essai_utilise')->value ?? FALSE)) {
    $account->set('field_essai_utilise', 1);
    $account->save();
  }

  \Drupal::logger('unisonges_structure')->notice('COURS À PAYER reservation @sid consumed pay-on-site right @right from order @order for user @uid.', [
    '@sid' => $sid,
    '@right' => $row->id,
    '@order' => $row->order_id,
    '@uid' => $uid,
  ]);

  return [
    'type' => 'pay_on_site',
    'right_id' => (int) $row->id,
    'order_id' => (int) $row->order_id,
    'source_order_item_id' => (int) $row->source_order_item_id,
  ];
}

function _unisonges_structure_acquire_course_rights_lock(int $uid): bool {
  if ($uid <= 0) {
    return FALSE;
  }

  if (!\Drupal::lock()->acquire(_unisonges_structure_course_rights_lock_id($uid), 30.0)) {
    return FALSE;
  }

  register_shutdown_function('_unisonges_structure_release_course_rights_lock', $uid);
  return TRUE;
}

function _unisonges_structure_release_course_rights_lock(int $uid): void {
  if ($uid <= 0) {
    return;
  }

  \Drupal::lock()->release(_unisonges_structure_course_rights_lock_id($uid));
}

function _unisonges_structure_course_rights_lock_id(int $uid): string {
  return 'unisonges_structure:course_rights:' . $uid;
}

function _unisonges_structure_get_submission_payment_context(\Drupal\webform\WebformSubmissionInterface $webform_submission): array {
  $context = [
    'status' => 'paid_credit',
    'label' => 'crédit payé',
    'source' => 'paid_credit',
    'log_label' => 'paid_credit',
    'order_id' => 0,
    'source_order_item_id' => 0,
  ];

  $row = _unisonges_structure_get_submission_to_pay_right($webform_submission);
  if (!$row) {
    return $context;
  }

  $context['source'] = 'pay_on_site';
  $context['order_id'] = (int) $row->order_id;
  $context['source_order_item_id'] = (int) $row->source_order_item_id;

  if ((string) $row->status === 'paid') {
    $context['status'] = 'paid';
    $context['label'] = 'paiement sur place confirmé';
    $context['log_label'] = 'pay_on_site_paid';
    return $context;
  }

  if ((string) $row->status === 'cancelled') {
    $context['status'] = 'cancelled';
    $context['label'] = 'paiement sur place annulé';
    $context['log_label'] = 'pay_on_site_cancelled';
    return $context;
  }

  $context['status'] = 'to_pay';
  $context['label'] = 'COURS À PAYER';
  $context['log_label'] = 'COURS À PAYER';
  return $context;
}

function _unisonges_structure_get_submission_to_pay_right(\Drupal\webform\WebformSubmissionInterface $webform_submission): ?object {
  $sid = (int) $webform_submission->id();
  if ($sid <= 0 || !_unisonges_structure_to_pay_rights_table_exists()) {
    return NULL;
  }

  $row = \Drupal::database()->select(_unisonges_structure_to_pay_rights_table_name(), 'r')
    ->fields('r')
    ->condition('webform_submission_id', $sid)
    ->orderBy('id', 'ASC')
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  return $row ?: NULL;
}

function _unisonges_structure_alter_reservation_to_pay_mail(array &$message): void {
  $params = $message['params'] ?? [];
  $webform_submission = NULL;
  foreach (['webform_submission', 'submission'] as $key) {
    if (($params[$key] ?? NULL) instanceof \Drupal\webform\WebformSubmissionInterface) {
      $webform_submission = $params[$key];
      break;
    }
  }

  if (!$webform_submission instanceof \Drupal\webform\WebformSubmissionInterface || $webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $payment = _unisonges_structure_get_submission_payment_context($webform_submission);
  if ($payment['status'] !== 'to_pay') {
    $owner = $webform_submission->getOwner();
    if (!$owner instanceof \Drupal\user\UserInterface || _unisonges_structure_user_has_valid_paid_credit($owner) || _unisonges_structure_count_available_to_pay_course_rights((int) $owner->id()) <= 0) {
      return;
    }
    $payment['status'] = 'to_pay';
  }

  if ($payment['status'] !== 'to_pay') {
    return;
  }

  $subject = (string) ($message['subject'] ?? '');
  $is_admin_notification = strpos($subject, 'Nouvelle demande de réservation cours particuliers') !== FALSE;
  if ($is_admin_notification && strpos($subject, 'COURS À PAYER') === FALSE) {
    $message['subject'] = '[COURS À PAYER] ' . $subject;
  }

  $line = $is_admin_notification
    ? '<p><strong>COURS À PAYER</strong> - réservation issue d’une commande avec paiement sur place non confirmé.</p>'
    : '<p>Paiement : cours à payer sur place.</p>';
  _unisonges_structure_append_mail_body_once($message, $line);
}

function _unisonges_structure_append_mail_body_once(array &$message, string $line): void {
  if (!isset($message['body']) || !is_array($message['body'])) {
    $message['body'] = [];
  }

  foreach ($message['body'] as $existing) {
    if (is_string($existing) && strpos($existing, strip_tags($line)) !== FALSE) {
      return;
    }
    if (is_string($existing) && strpos($existing, $line) !== FALSE) {
      return;
    }
  }

  $message['body'][] = $line;
}

function _unisonges_structure_to_pay_rights_table_name(): string {
  return 'unisonges_structure_course_to_pay_right';
}

function _unisonges_structure_to_pay_rights_table_exists(): bool {
  try {
    return \Drupal::database()->schema()->tableExists(_unisonges_structure_to_pay_rights_table_name());
  }
  catch (\Throwable $e) {
    return FALSE;
  }
}

function _unisonges_structure_log_missing_to_pay_rights_table_once(): void {
  static $logged = FALSE;
  if ($logged) {
    return;
  }

  \Drupal::logger('unisonges_structure')->warning('Pay-on-site course rights table @table is missing; run database updates before using pay-on-site reservation rights.', [
    '@table' => _unisonges_structure_to_pay_rights_table_name(),
  ]);
  $logged = TRUE;
}

function unisonges_structure_webform_submission_insert(\Drupal\webform\WebformSubmissionInterface $webform_submission): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  try {
    $booking = _unisonges_structure_get_submission_booking_request($webform_submission);
    if ($booking === NULL) {
      \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid skipped credit decrement because the reservation value is empty, invalid, or cancelled.', [
        '@sid' => $webform_submission->id(),
      ]);
      return;
    }

    $conflict_message = _unisonges_structure_get_submission_booking_conflict_message($webform_submission);
    if ($conflict_message !== '') {
      $inactive_value = _unisonges_structure_build_inactive_booking_value($booking['slot']);
      $fallback_updated = _unisonges_structure_update_stored_submission_reservation($webform_submission, $inactive_value);
      \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid skipped credit decrement and Google queue because it conflicts with existing bookings: @message', [
        '@sid' => $webform_submission->id(),
        '@message' => $conflict_message,
      ]);
      \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid stored reservation marked inactive after insert conflict (updated=@updated, value=@value).', [
        '@sid' => $webform_submission->id(),
        '@updated' => $fallback_updated ? 'yes' : 'no',
        '@value' => $inactive_value,
      ]);
      return;
    }

    $uid = (int) $webform_submission->getOwnerId();
    if (!$uid) {
      return;
    }

    $account = \Drupal\user\Entity\User::load($uid);
    if (!$account) {
      return;
    }

    if (!_unisonges_structure_acquire_course_rights_lock($uid)) {
      $inactive_value = _unisonges_structure_build_inactive_booking_value($booking['slot']);
      $fallback_updated = _unisonges_structure_update_stored_submission_reservation($webform_submission, $inactive_value);
      \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid was marked inactive because course rights for user @uid are currently locked (updated=@updated).', [
        '@sid' => $webform_submission->id(),
        '@uid' => $uid,
        '@updated' => $fallback_updated ? 'yes' : 'no',
      ]);
      return;
    }

    try {
      $account = \Drupal\user\Entity\User::load($uid);
      if (!$account || !$account->hasField('field_seances_restantes')) {
        \Drupal::logger('unisonges_structure')->error('Reservation submission @sid could not consume a course right for user @uid because field_seances_restantes is missing.', [
          '@sid' => $webform_submission->id(),
          '@uid' => $uid,
        ]);
        return;
      }

      $consumption = _unisonges_structure_consume_booking_right($account, $webform_submission);
      if ($consumption['type'] === '') {
        $inactive_value = _unisonges_structure_build_inactive_booking_value($booking['slot']);
        $fallback_updated = _unisonges_structure_update_stored_submission_reservation($webform_submission, $inactive_value);
        \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid was marked inactive because no paid credit or pay-on-site right remained for user @uid at insert time (updated=@updated).', [
          '@sid' => $webform_submission->id(),
          '@uid' => $uid,
          '@updated' => $fallback_updated ? 'yes' : 'no',
        ]);
        return;
      }
    }
    finally {
      _unisonges_structure_release_course_rights_lock($uid);
    }

    _unisonges_structure_queue_google_calendar_booking_sync($webform_submission, 'pending_create');

    _unisonges_structure_log_booking_transition($webform_submission, 'insert', NULL);
  }
  finally {
    _unisonges_structure_release_booking_slot_lock_from_submission($webform_submission);
  }
}

function unisonges_structure_webform_submission_update(\Drupal\webform\WebformSubmissionInterface $webform_submission): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  try {
    $original_reservation = NULL;
    if (isset($webform_submission->original) && $webform_submission->original instanceof \Drupal\webform\WebformSubmissionInterface) {
      $original_reservation = _unisonges_structure_get_submission_element_string($webform_submission->original, 'reservation');
    }

    $current_reservation = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
    if ($current_reservation !== '' && $original_reservation !== $current_reservation) {
      $sync_action = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'pending_cancel' : 'pending_update';
      $conflict_message = $sync_action === 'pending_cancel' ? '' : _unisonges_structure_get_submission_booking_conflict_message($webform_submission);
      if ($conflict_message === '') {
        _unisonges_structure_queue_google_calendar_booking_sync($webform_submission, $sync_action);
      }
      else {
        $fallback_value = '';
        $fallback_action = 'marked inactive';
        $current_booking = _unisonges_structure_get_submission_booking_request($webform_submission);
        if ($original_reservation !== NULL && $original_reservation !== '') {
          $fallback_value = $original_reservation;
          $fallback_action = 'restored previous reservation';
        }
        elseif ($current_booking !== NULL) {
          $fallback_value = _unisonges_structure_build_inactive_booking_value($current_booking['slot']);
        }

        $fallback_updated = $fallback_value !== '' ? _unisonges_structure_update_stored_submission_reservation($webform_submission, $fallback_value) : FALSE;
        \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid skipped Google queue update because it conflicts with existing bookings: @message', [
          '@sid' => $webform_submission->id(),
          '@message' => $conflict_message,
        ]);
        \Drupal::logger('unisonges_structure')->warning('Reservation submission @sid stored reservation fallback applied after update conflict: @action (updated=@updated, value=@value).', [
          '@sid' => $webform_submission->id(),
          '@action' => $fallback_action,
          '@updated' => $fallback_updated ? 'yes' : 'no',
          '@value' => $fallback_value,
        ]);
      }
    }

    _unisonges_structure_log_booking_transition($webform_submission, 'update', $original_reservation);
  }
  finally {
    _unisonges_structure_release_booking_slot_lock_from_submission($webform_submission);
  }
}

function _unisonges_structure_log_booking_transition(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $trigger, ?string $original_reservation = NULL): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $current_reservation = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
  $transition = 'unchanged';

  if ($trigger === 'insert') {
    $transition = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'insert_cancelled' : 'created';
  }
  elseif ($original_reservation === NULL) {
    $transition = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'cancelled_no_original' : 'updated_no_original';
  }
  elseif ($original_reservation === $current_reservation) {
    $transition = 'unchanged';
  }
  elseif (!_unisonges_structure_is_cancelled_booking_value($original_reservation) && _unisonges_structure_is_cancelled_booking_value($current_reservation)) {
    $transition = 'cancelled';
  }
  elseif ($original_reservation === '' && $current_reservation !== '') {
    $transition = 'created';
  }
  else {
    $transition = 'modified';
  }

  $payment = _unisonges_structure_get_submission_payment_context($webform_submission);
  \Drupal::logger('unisonges_booking_sync')->notice(
    'Booking @transition on @webform_id submission @sid (uid=@uid, uuid=@uuid, trigger=@trigger, payment=@payment, old=@old, new=@new).',
    [
      '@transition' => $transition,
      '@webform_id' => $webform_submission->getWebform()->id(),
      '@sid' => $webform_submission->id(),
      '@uid' => $webform_submission->getOwnerId(),
      '@uuid' => $webform_submission->uuid(),
      '@trigger' => $trigger,
      '@payment' => $payment['log_label'],
      '@old' => $original_reservation ?? '',
      '@new' => $current_reservation,
    ]
  );
}

function _unisonges_structure_is_cancelled_booking_value(?string $value): bool {
  return unisonges_structure_is_cancelled_booking_value($value);
}

/**
 * UNISONGES_GOOGLE_CALENDAR_BOOKING_SYNC_SKELETON
 *
 * This skeleton only stores internal dry-run Google Calendar event payloads
 * for course bookings. It does not perform OAuth, call Google APIs, send
 * events externally, or create a real system cron task.
 *
 * Next step: add Google OAuth/API integration, then process this table from
 * a Drupal cron or queue runner scheduled every 5 minutes.
 */

/**
 * Parses a webform_booking reservation value.
 */
function unisonges_structure_parse_booking_reservation_value(?string $value): ?array {
  $value = trim((string) $value);
  if ($value === '') {
    return NULL;
  }

  if (preg_match('/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})\|(\d+)$/', $value, $matches) !== 1) {
    return NULL;
  }

  $timezone = _unisonges_structure_get_booking_sync_timezone();
  try {
    $start = new \DateTimeImmutable($matches[1] . ' ' . $matches[2], new \DateTimeZone($timezone));
  }
  catch (\Throwable $e) {
    return NULL;
  }

  if ($start->format('Y-m-d H:i') !== $matches[1] . ' ' . $matches[2]) {
    return NULL;
  }

  $seats = (int) $matches[3];
  return [
    'raw' => $value,
    'date' => $matches[1],
    'time' => $matches[2],
    'seats' => $seats,
    'cancelled' => $seats === 0,
    'start' => $start,
    'timezone' => $timezone,
  ];
}

/**
 * Determines whether a reservation value is a webform_booking cancellation.
 */
function unisonges_structure_is_cancelled_booking_value(?string $value): bool {
  $parsed = unisonges_structure_parse_booking_reservation_value($value);
  if ($parsed !== NULL) {
    return !empty($parsed['cancelled']);
  }

  $value = trim((string) $value);
  return $value !== '' && preg_match('/\|0$/', $value) === 1;
}

/**
 * Builds a Google Calendar event payload without sending it.
 */
function unisonges_structure_build_google_calendar_dry_run_payload(\Drupal\webform\WebformSubmissionInterface $webform_submission): ?array {
  $reservation = unisonges_structure_parse_booking_reservation_value(
    _unisonges_structure_get_submission_element_string($webform_submission, 'reservation')
  );
  if ($reservation === NULL || !$reservation['start'] instanceof \DateTimeImmutable) {
    return NULL;
  }

  $slot_duration = _unisonges_structure_get_booking_slot_duration_minutes($webform_submission);
  $end = $reservation['start']->modify('+' . $slot_duration . ' minutes');
  $timezone = (string) $reservation['timezone'];
  $payment = _unisonges_structure_get_submission_payment_context($webform_submission);

  return [
    'summary' => _unisonges_structure_build_booking_google_summary($webform_submission),
    'location' => _unisonges_structure_build_booking_google_location($webform_submission),
    'description' => _unisonges_structure_build_booking_google_description($webform_submission),
    'start' => [
      'dateTime' => $reservation['start']->format(\DateTimeInterface::RFC3339),
      'timeZone' => $timezone,
    ],
    'end' => [
      'dateTime' => $end->format(\DateTimeInterface::RFC3339),
      'timeZone' => $timezone,
    ],
    'extendedProperties' => [
      'private' => [
        'drupal_webform_id' => $webform_submission->getWebform()->id(),
        'drupal_submission_id' => (string) $webform_submission->id(),
        'drupal_submission_uuid' => (string) $webform_submission->uuid(),
        'payment_status' => $payment['status'],
        'payment_label' => $payment['label'],
        'payment_source' => $payment['source'],
        'commerce_order_id' => $payment['order_id'] > 0 ? (string) $payment['order_id'] : '',
        'commerce_order_item_id' => $payment['source_order_item_id'] > 0 ? (string) $payment['source_order_item_id'] : '',
        'unisonges_sync_version' => '1',
      ],
    ],
  ];
}

/**
 * Queues an internal dry-run Google Calendar sync action.
 */
function _unisonges_structure_queue_google_calendar_booking_sync(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $sync_action): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  if (!in_array($sync_action, ['pending_create', 'pending_update', 'pending_cancel'], TRUE)) {
    return;
  }

  $reservation_value = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
  if ($reservation_value === '') {
    return;
  }

  $sid = (int) $webform_submission->id();
  if ($sid <= 0) {
    return;
  }

  $table = _unisonges_structure_booking_sync_table_name();
  if (!_unisonges_structure_booking_sync_table_exists()) {
    static $missing_table_logged = FALSE;
    if (!$missing_table_logged) {
      \Drupal::logger('unisonges_booking_sync')->warning('Booking sync table @table is missing; dry-run queue skipped until database updates run.', [
        '@table' => $table,
      ]);
      $missing_table_logged = TRUE;
    }
    return;
  }

  $payload = unisonges_structure_build_google_calendar_dry_run_payload($webform_submission);
  $payload_json = NULL;
  $last_error = NULL;
  if ($payload === NULL) {
    $last_error = 'Unable to build dry-run Google Calendar payload from reservation value.';
  }
  else {
    $payload_json = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($payload_json === FALSE) {
      $payload_json = NULL;
      $last_error = 'Unable to JSON encode dry-run Google Calendar payload.';
    }
  }

  $now = \Drupal::time()->getRequestTime();
  $cancelled = $sync_action === 'pending_cancel' || _unisonges_structure_is_cancelled_booking_value($reservation_value) ? $now : NULL;
  $fields = [
    'submission_uuid' => (string) $webform_submission->uuid(),
    'sync_status' => 'pending',
    'sync_action' => $sync_action,
    'reservation_value' => $reservation_value,
    'payload_json' => $payload_json,
    'last_error' => $last_error,
    'changed' => $now,
    'cancelled' => $cancelled,
  ];

  try {
    \Drupal::database()->merge($table)
      ->keys(['sid' => $sid])
      ->insertFields($fields + [
        'sid' => $sid,
        'google_event_id' => NULL,
        'created' => $now,
        'last_synced' => NULL,
      ])
      ->updateFields($fields)
      ->execute();

    $payment = _unisonges_structure_get_submission_payment_context($webform_submission);
    \Drupal::logger('unisonges_booking_sync')->notice(
      'Booking Google Calendar dry-run sync queued as @action for submission @sid (uuid=@uuid, reservation=@reservation, payment=@payment).',
      [
        '@action' => $sync_action,
        '@sid' => $sid,
        '@uuid' => $webform_submission->uuid(),
        '@reservation' => $reservation_value,
        '@payment' => $payment['log_label'],
      ]
    );
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_booking_sync')->error(
      'Booking Google Calendar dry-run sync queue failed for submission @sid: @message',
      [
        '@sid' => $sid,
        '@message' => $e->getMessage(),
      ]
    );
  }
}

/**
 * Returns the internal sync table name.
 */
function _unisonges_structure_booking_sync_table_name(): string {
  return 'unisonges_structure_booking_gcal_sync';
}

/**
 * Checks whether the internal sync table is available.
 */
function _unisonges_structure_booking_sync_table_exists(): bool {
  try {
    return \Drupal::database()->schema()->tableExists(_unisonges_structure_booking_sync_table_name());
  }
  catch (\Throwable $e) {
    return FALSE;
  }
}

/**
 * Returns a submission element value as a compact string.
 */
function _unisonges_structure_get_submission_element_string(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): string {
  $value = $webform_submission->getElementData($element_key);
  if ($value === NULL) {
    return '';
  }

  if (is_array($value)) {
    $parts = [];
    foreach ($value as $item) {
      if (is_scalar($item)) {
        $parts[] = trim((string) $item);
      }
    }
    return trim(implode(', ', array_filter($parts, 'strlen')));
  }

  if (is_bool($value)) {
    return $value ? '1' : '0';
  }

  if (!is_scalar($value)) {
    return '';
  }

  return trim((string) $value);
}

/**
 * Resolves the site timezone used for booking dry-run payloads.
 */
function _unisonges_structure_get_booking_sync_timezone(): string {
  $timezone = '';
  try {
    $timezone = (string) \Drupal::config('unisonges_structure.google_calendar')->get('timezone');
  }
  catch (\Throwable $e) {
    $timezone = '';
  }

  if ($timezone === '') {
    $timezone = 'Europe/Paris';
  }

  try {
    new \DateTimeZone($timezone);
  }
  catch (\Throwable $e) {
    return 'Europe/Paris';
  }

  return $timezone;
}

/**
 * Reads the webform_booking slot duration from the reservation element.
 */
function _unisonges_structure_get_booking_slot_duration_minutes(\Drupal\webform\WebformSubmissionInterface $webform_submission): int {
  $element = _unisonges_structure_get_webform_element_definition($webform_submission, 'reservation');
  $duration = isset($element['#slot_duration']) ? (int) $element['#slot_duration'] : 0;

  return $duration > 0 ? $duration : 60;
}

/**
 * Returns a webform element definition when available.
 */
function _unisonges_structure_get_webform_element_definition(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): array {
  $webform = $webform_submission->getWebform();

  try {
    if (method_exists($webform, 'getElementDecoded')) {
      $element = $webform->getElementDecoded($element_key);
      if (is_array($element)) {
        return $element;
      }
    }

    if (method_exists($webform, 'getElementsDecoded')) {
      $elements = $webform->getElementsDecoded();
      if (isset($elements[$element_key]) && is_array($elements[$element_key])) {
        return $elements[$element_key];
      }
    }
  }
  catch (\Throwable $e) {
    return [];
  }

  return [];
}

/**
 * Builds the Google Calendar summary for a course booking.
 */
function _unisonges_structure_build_booking_google_summary(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $parts = ['Cours particulier'];
  $payment = _unisonges_structure_get_submission_payment_context($webform_submission);
  if ($payment['status'] === 'to_pay') {
    $parts[] = 'COURS À PAYER';
  }
  foreach (['instrument', 'mode_cours'] as $element_key) {
    $label = _unisonges_structure_get_submission_option_label($webform_submission, $element_key);
    if ($label !== '') {
      $parts[] = $label;
    }
  }

  $owner = $webform_submission->getOwner();
  if ($owner && trim($owner->getDisplayName()) !== '') {
    $parts[] = trim($owner->getDisplayName());
  }

  return implode(' - ', $parts);
}

/**
 * Builds the Google Calendar location for a course booking.
 */
function _unisonges_structure_build_booking_google_location(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $mode = _unisonges_structure_get_submission_element_string($webform_submission, 'mode_cours');
  if ($mode === 'domicile') {
    $address = _unisonges_structure_get_submission_element_string($webform_submission, 'adresse_domicile');
    return $address !== '' ? $address : 'Domicile';
  }

  if ($mode === 'visio') {
    $platform = _unisonges_structure_get_submission_option_label($webform_submission, 'plateforme_visio');
    return $platform !== '' ? $platform : 'Visio';
  }

  if ($mode === 'studio') {
    // Confirmed from the current webform description; make configurable before real sync.
    return '1 rue du chemin vert, 93300 Aubervilliers';
  }

  return '';
}

/**
 * Builds the Google Calendar description for a course booking.
 */
function _unisonges_structure_build_booking_google_description(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $payment = _unisonges_structure_get_submission_payment_context($webform_submission);
  $lines = [
    'sid: ' . (string) $webform_submission->id(),
    'uuid: ' . (string) $webform_submission->uuid(),
    'uid: ' . (string) $webform_submission->getOwnerId(),
    'payment_status: ' . $payment['status'],
    'payment_label: ' . $payment['label'],
    'payment_source: ' . $payment['source'],
    'telephone: ' . _unisonges_structure_get_submission_element_string($webform_submission, 'telephone'),
    'instrument: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'instrument'),
    'niveau_cours: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'niveau_cours'),
    'notes_supplementaires: ' . _unisonges_structure_get_submission_element_string($webform_submission, 'notes_supplementaires'),
    'didgeridoo_pret: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'didgeridoo_pret'),
  ];
  if ($payment['order_id'] > 0) {
    $lines[] = 'commerce_order_id: ' . (string) $payment['order_id'];
  }
  if ($payment['source_order_item_id'] > 0) {
    $lines[] = 'commerce_order_item_id: ' . (string) $payment['source_order_item_id'];
  }

  return implode("\n", $lines);
}

/**
 * Returns an option label for a submitted value when the webform exposes it.
 */
function _unisonges_structure_get_submission_option_label(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): string {
  $value = _unisonges_structure_get_submission_element_string($webform_submission, $element_key);
  if ($value === '') {
    return '';
  }

  $element = _unisonges_structure_get_webform_element_definition($webform_submission, $element_key);
  $options = $element['#options'] ?? [];
  if (!is_array($options)) {
    return $value;
  }

  if (isset($options[$value]) && is_scalar($options[$value])) {
    return trim((string) $options[$value]);
  }

  return $value;
}
