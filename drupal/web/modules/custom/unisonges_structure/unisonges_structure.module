<?php

/**
 * @file
 * Hooks and custom code for the Unisonges Structure module.
 */

/**
 * UNISONGES_AUTOGEN_TICKETS
 * Auto-create and keep in sync a Commerce ticket product for Stage/Concert nodes.
 *
 * Files:
 * - web/modules/custom/unisonges_structure/unisonges_structure.module
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\commerce_product\Entity\Product;
use Drupal\commerce_product\Entity\ProductVariation;

/**
 * Implements hook_entity_insert().
 */
function unisonges_structure_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    _unisonges_structure_sync_ticket_product($entity);
  }
  if ($entity instanceof \Drupal\commerce_order\Entity\OrderInterface) {
    _unisonges_structure_apply_course_rights_from_order($entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function unisonges_structure_entity_update(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface) {
    _unisonges_structure_sync_ticket_product($entity);
  }
  if ($entity instanceof \Drupal\commerce_order\Entity\OrderInterface) {
    _unisonges_structure_apply_course_rights_from_order($entity);
  }
}

/**
 * Implements hook_cron().
 */
function unisonges_structure_cron(): void {
  try {
    $container = \Drupal::getContainer();
    if (!$container->has('unisonges_structure.booking_calendar_sync')) {
      return;
    }

    $container->get('unisonges_structure.booking_calendar_sync')->processPendingFromCron();
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_booking_sync')->error('Google Calendar booking sync cron failed: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Implements hook_preprocess_node().
 */
function unisonges_structure_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || (int) $node->id() !== 8) {
    return;
  }

  $variables['unisonges_reservation_portal'] = _unisonges_structure_build_reservation_portal_context();
  $variables['unisonges_reservation_form'] = _unisonges_structure_build_course_reservation_form();

  $variables['elements']['#cache']['contexts'][] = 'user';
  $variables['content']['#cache']['contexts'][] = 'user';
}

/**
 * Ensure a Stage/Concert node has a linked ticket product; create/update it as needed.
 *
 * - Creates ticket product/variation if missing.
 * - Copies: title, linked page, (optional) ticket price, (optional) capacity mirror.
 * - Publishes/unpublishes product with node status ONLY if a ticket price is provided.
 *
 * Note: uses a recursion guard because we may save the node to store the product reference.
 */
function _unisonges_structure_sync_ticket_product(NodeInterface $node): void {
  $bundle = $node->bundle();
  if (!in_array($bundle, ['stage', 'concert'], TRUE)) {
    return;
  }

  static $in_progress = [];
  $nid = (int) $node->id();
  if ($nid && !empty($in_progress[$nid])) {
    return;
  }
  if ($nid) {
    $in_progress[$nid] = TRUE;
  }

  try {
    $product_type = $bundle === 'stage' ? 'ticket_stage' : 'ticket_concert';
    $variation_type = $product_type; // same ids in our setup

    // Resolve product: prefer reverse link field if present, else query by linked page.
    $product = NULL;
    if ($node->hasField('field_linked_ticket') && !$node->get('field_linked_ticket')->isEmpty()) {
      $pid = (int) $node->get('field_linked_ticket')->target_id;
      $product = $pid ? Product::load($pid) : NULL;
    }

    if (!$product) {
      $pids = \Drupal::entityQuery('commerce_product')
        ->accessCheck(FALSE)
        ->condition('type', $product_type)
        ->condition('field_linked_page.target_id', $nid)
        ->range(0, 1)
        ->execute();
      if ($pids) {
        $product = Product::load((int) reset($pids));
      }
    }

    // Read optional ticket price from node.
    $price = NULL;
    if ($node->hasField('field_ticket_price') && !$node->get('field_ticket_price')->isEmpty()) {
      $item = $node->get('field_ticket_price')->first();
      if ($item && method_exists($item, 'toPrice')) {
        $price = $item->toPrice();
      }
    }

    // Read optional capacity from node.
    $capacity = NULL;
    if ($node->hasField('field_capacity') && !$node->get('field_capacity')->isEmpty()) {
      $capacity = (int) $node->get('field_capacity')->value;
    }

    // Ensure product exists.
    if (!$product) {
      // Create variation first (unpublished by default).
      $variation = ProductVariation::create([
        'type' => $variation_type,
        'sku' => sprintf('AUTO-%s-%d', strtoupper($bundle), $nid),
        'status' => 0,
      ]);
      if ($price) {
        $variation->set('price', $price);
      }
      if ($capacity !== NULL && $variation->hasField('field_ticket_capacity')) {
        $variation->set('field_ticket_capacity', $capacity);
      }
      $variation->save();

      // Create product (unpublished until priced).
      $product = Product::create([
        'type' => $product_type,
        'title' => $node->label(),
        'status' => 0,
        'stores' => [['target_id' => 1]],
        'field_linked_page' => [['target_id' => $nid]],
      ]);
      $product->save();
      $product->addVariation($variation);
      $product->save();
    }

    // Update product fields to match node.
    $product->setTitle($node->label());
    if ($product->hasField('field_linked_page')) {
      $product->set('field_linked_page', [['target_id' => $nid]]);
    }

    // Update variation (first variation).
    $variations = $product->getVariations();
    $variation = $variations ? reset($variations) : NULL;
    if ($variation) {
      if ($price) {
        $variation->set('price', $price);
      }
      if ($capacity !== NULL && $variation->hasField('field_ticket_capacity')) {
        $variation->set('field_ticket_capacity', $capacity);
      }
      // Publish/unpublish ticket only if we have a price filled.
      if ($price) {
        $variation->set('status', $node->isPublished() ? 1 : 0);
      }
      $variation->save();
    }

    if ($price) {
      $product->set('status', $node->isPublished() ? 1 : 0);
    }
    $product->save();

    // Store reverse link on node if field exists and empty.
    if ($node->hasField('field_linked_ticket') && $node->get('field_linked_ticket')->isEmpty()) {
      $node->set('field_linked_ticket', $product->id());
      // Save quietly: recursion guard already set.
      $node->save();
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_structure')->error('Ticket autogen failed for node @nid: @msg', [
      '@nid' => $nid ?: '(new)',
      '@msg' => $e->getMessage(),
    ]);
  }
  finally {
    if ($nid) {
      unset($in_progress[$nid]);
    }
  }
}


/**
 * UNISONGES_COURSE_BOOKING_RIGHTS
 */
function unisonges_structure_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  $webform = $form['#webform'] ?? NULL;
  if (!$webform || $webform->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $message = '';
  $current_user = \Drupal::currentUser();

  if ($current_user->isAnonymous()) {
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#access'] = FALSE;
    }
    $form['unisonges_booking_notice'] = [
      '#type' => 'markup',
      '#markup' => '<div class="messages messages--status" role="status" aria-live="polite"><div class="messages__content">Connectez-vous pour réserver un créneau.</div></div>',
      '#weight' => 999,
    ];
  }
  else {
    $account = \Drupal\user\Entity\User::load($current_user->id());
    if (!$account || !_unisonges_structure_user_can_book($account, $message)) {
      if (isset($form['actions']['submit'])) {
        $form['actions']['submit']['#access'] = FALSE;
      }
      $safe = htmlspecialchars($message ?: 'Vous ne pouvez pas réserver pour le moment.', ENT_QUOTES, 'UTF-8');
      $form['unisonges_booking_notice'] = [
        '#type' => 'markup',
        '#markup' => '<div class="messages messages--status" role="status" aria-live="polite"><div class="messages__content">' . $safe . '</div></div>',
        '#weight' => 999,
      ];
    }
  }

  $form['#validate'][] = 'unisonges_structure_booking_form_validate';
  _unisonges_structure_booking_form_ux_overrides($form);
}

/**
 * Builds the front reservation portal state for /reserver.
 */
function _unisonges_structure_build_reservation_portal_context(): array {
  $context = [
    'is_anonymous' => TRUE,
    'display_name' => '',
    'remaining' => NULL,
    'remaining_label' => 'Connectez-vous pour voir vos séances disponibles.',
    'expiry_label' => '',
    'status' => 'anonymous',
    'status_label' => 'Connexion requise pour confirmer une réservation.',
    'message' => 'Vous pouvez consulter les disponibilités. La validation du créneau demande un compte connecté.',
    'can_book' => FALSE,
    'login_url' => _unisonges_structure_safe_route_url('user.login', '/user/login', ['destination' => '/reserver']),
    'register_url' => _unisonges_structure_safe_route_url('user.register', '/user/register', ['destination' => '/reserver']),
    'purchase_url' => '/cours',
    'purchase_label' => 'Acheter une séance ou un pack',
  ];

  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    return $context;
  }

  $context['is_anonymous'] = FALSE;
  $account = \Drupal\user\Entity\User::load($current_user->id());
  if (!$account) {
    $context['status'] = 'error';
    $context['status_label'] = 'Compte introuvable.';
    $context['message'] = 'Impossible de lire vos droits de cours pour le moment.';
    return $context;
  }

  $remaining = $account->hasField('field_seances_restantes') ? max(0, (int) ($account->get('field_seances_restantes')->value ?? 0)) : 0;
  $message = '';
  $can_book = _unisonges_structure_user_can_book($account, $message);
  $expiry_value = $account->hasField('field_pack_expire_le') ? (string) ($account->get('field_pack_expire_le')->value ?? '') : '';

  $context['display_name'] = trim($account->getDisplayName());
  $context['remaining'] = $remaining;
  $context['remaining_label'] = $remaining <= 1 ? $remaining . ' séance disponible' : $remaining . ' séances disponibles';
  $context['can_book'] = $can_book;
  $context['expiry_label'] = _unisonges_structure_format_course_pack_expiry($expiry_value);

  if ($can_book) {
    $context['status'] = 'ready';
    $context['status_label'] = 'Vous pouvez réserver un créneau.';
    $context['message'] = 'Choisissez une disponibilité, puis complétez les informations du cours.';
  }
  else {
    $context['status'] = 'blocked';
    $context['status_label'] = 'Aucune réservation possible pour le moment.';
    $context['message'] = $message ?: 'Achetez une séance ou un pack avant de confirmer un créneau.';
  }

  return $context;
}

/**
 * Builds the course reservation webform render array.
 */
function _unisonges_structure_build_course_reservation_form(): array {
  try {
    if (!\Drupal::moduleHandler()->moduleExists('webform')) {
      return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation est indisponible pour le moment.');
    }

    $webform = \Drupal::entityTypeManager()->getStorage('webform')->load('cours_particuliers_reservation');
    if (!$webform) {
      return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation est introuvable.');
    }

    if (method_exists($webform, 'getSubmissionForm')) {
      return $webform->getSubmissionForm();
    }

    if (class_exists('Drupal\webform\Entity\WebformSubmission')) {
      $submission = \Drupal\webform\Entity\WebformSubmission::create([
        'webform_id' => $webform->id(),
      ]);
      return \Drupal::service('entity.form_builder')->getForm($submission);
    }
  }
  catch (\Drupal\Core\Form\FormAjaxException $e) {
    throw $e;
  }
  catch (\Drupal\Core\Form\EnforcedResponseException $e) {
    throw $e;
  }
  catch (\Throwable $e) {
    $exception_class = get_class($e);
    \Drupal::logger('unisonges_structure')->error('Reservation portal webform build failed: @exception: @message', [
      '@exception' => $exception_class,
      '@message' => $e->getMessage() ?: $exception_class,
    ]);
  }

  return _unisonges_structure_reservation_portal_notice('Le formulaire de réservation ne peut pas être affiché pour le moment.');
}

/**
 * Builds a small portal notice render array.
 */
function _unisonges_structure_reservation_portal_notice(string $message): array {
  return [
    '#type' => 'markup',
    '#markup' => '<p class="reservation-portal__notice">' . htmlspecialchars($message, ENT_QUOTES, 'UTF-8') . '</p>',
  ];
}

/**
 * Formats the course pack expiry date for the front portal.
 */
function _unisonges_structure_format_course_pack_expiry(string $value): string {
  if ($value === '') {
    return '';
  }

  try {
    $date = new \DateTimeImmutable($value);
  }
  catch (\Throwable $e) {
    return '';
  }

  $today = new \DateTimeImmutable('today');
  $label = $date->format('d/m/Y');
  if ($date < $today) {
    return 'Pack expiré le ' . $label;
  }

  return 'Pack valable jusqu’au ' . $label;
}

/**
 * Builds a route URL with a static fallback.
 */
function _unisonges_structure_safe_route_url(string $route_name, string $fallback, array $query = []): string {
  try {
    return Url::fromRoute($route_name, [], ['query' => $query])->toString();
  }
  catch (\Throwable $e) {
    if (!$query) {
      return $fallback;
    }

    return $fallback . '?' . http_build_query($query);
  }
}



function _unisonges_structure_booking_form_ux_overrides(array &$form): void {
  foreach (['reservation', 'elements'] as $key) {
    if ($key === 'reservation' && isset($form['reservation']) && is_array($form['reservation'])) {
      $form['reservation']['#required_error'] = 'Choisissez un créneau.';
    }
    if ($key === 'elements' && isset($form['elements']['reservation']) && is_array($form['elements']['reservation'])) {
      $form['elements']['reservation']['#required_error'] = 'Choisissez un créneau.';
    }
  }

  _unisonges_structure_remove_already_submitted_notice($form);
}

function _unisonges_structure_remove_already_submitted_notice(array &$element): void {
  $needles = [
    'You have already submitted this webform.',
    'View your previous submission.',
  ];

  foreach (array_keys($element) as $key) {
    if (!is_array($element[$key])) {
      continue;
    }

    $matched = FALSE;
    foreach (['#markup', '#plain_text', '#title', '#description'] as $prop) {
      if (!isset($element[$key][$prop]) || !is_string($element[$key][$prop])) {
        continue;
      }

      $value = html_entity_decode(strip_tags($element[$key][$prop]), ENT_QUOTES, 'UTF-8');
      foreach ($needles as $needle) {
        if (strpos($value, $needle) !== FALSE) {
          $matched = TRUE;
          break 2;
        }
      }
    }

    if ($matched) {
      unset($element[$key]);
      continue;
    }

    _unisonges_structure_remove_already_submitted_notice($element[$key]);
  }
}

function unisonges_structure_booking_form_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $webform = $form['#webform'] ?? NULL;
  if (!$webform || $webform->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ($current_user->isAnonymous()) {
    $form_state->setErrorByName('reservation', 'Connectez-vous pour réserver un créneau.');
    return;
  }

  $account = \Drupal\user\Entity\User::load($current_user->id());
  $message = '';
  if (!$account || !_unisonges_structure_user_can_book($account, $message)) {
    $form_state->setErrorByName('reservation', $message ?: 'Vous ne pouvez pas réserver pour le moment.');
  }
}

function _unisonges_structure_user_can_book(\Drupal\user\UserInterface $account, ?string &$message = ''): bool {
  if (!$account->hasField('field_seances_restantes')) {
    $message = 'Impossible de lire vos droits de cours pour le moment.';
    return FALSE;
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  if ($remaining <= 0) {
    $message = 'Aucune séance disponible. Achetez une séance, un pack, ou choisissez le paiement sur place.';
    return FALSE;
  }

  $expiry_value = $account->hasField('field_pack_expire_le') ? ($account->get('field_pack_expire_le')->value ?? '') : '';
  if ($expiry_value) {
    try {
      $today = new \DateTimeImmutable('today');
      $expiry = new \DateTimeImmutable($expiry_value);
    }
    catch (\Throwable $e) {
      $message = 'Impossible de lire la validité de vos droits de cours pour le moment.';
      return FALSE;
    }
    if ($expiry < $today) {
      $message = 'Votre pack a expiré. Merci d’acheter une nouvelle formule pour réserver.';
      return FALSE;
    }
  }

  return TRUE;
}

function _unisonges_structure_apply_course_rights_from_order(\Drupal\commerce_order\Entity\OrderInterface $order): void {
  if ($order->getState()->value !== 'completed') {
    return;
  }
  if ($order->getData('unisonges_course_rights_applied')) {
    return;
  }

  $uid = (int) $order->getCustomerId();
  if (!$uid) {
    return;
  }

  $account = \Drupal\user\Entity\User::load($uid);
  if (!$account) {
    return;
  }

  foreach (['field_seances_restantes', 'field_essai_utilise', 'field_pack_expire_le'] as $field_name) {
    if (!$account->hasField($field_name)) {
      \Drupal::logger('unisonges_structure')->error('Course rights could not be applied for order @order and user @uid because user field @field is missing.', [
        '@order' => $order->id(),
        '@uid' => $uid,
        '@field' => $field_name,
      ]);
      return;
    }
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  $essai_utilise = (bool) ($account->get('field_essai_utilise')->value ?? FALSE);
  $expiry_value = $account->get('field_pack_expire_le')->value ?? '';
  $expiry = $expiry_value ? new \DateTimeImmutable($expiry_value) : NULL;
  $today = new \DateTimeImmutable('today');
  $changed = FALSE;

  if ($expiry && $expiry < $today) {
    $remaining = 0;
    $expiry = NULL;
    $account->set('field_pack_expire_le', NULL);
    $changed = TRUE;
  }

  foreach ($order->getItems() as $order_item) {
    $quantity = (int) round((float) $order_item->getQuantity());
    if ($quantity < 1) {
      $quantity = 1;
    }

    $variation = $order_item->getPurchasedEntity();
    if (!$variation || !method_exists($variation, 'getProduct')) {
      continue;
    }
    $product = $variation->getProduct();
    if (!$product) {
      continue;
    }

    switch ($product->bundle()) {
      case 'cours_essai':
        if (!$essai_utilise) {
          $remaining += 1;
          $essai_utilise = TRUE;
          $changed = TRUE;
        }
        break;
      case 'cours_deb_inter':
      case 'cours_avance':
        $remaining += $quantity;
        $changed = TRUE;
        break;
      case 'pack_4_deb_inter':
        $remaining += (4 * $quantity);
        $base = ($expiry && $expiry >= $today) ? $expiry : $today;
        $expiry = $base->modify('+6 months');
        $changed = TRUE;
        break;
    }
  }

  if ($changed) {
    $account->set('field_seances_restantes', $remaining);
    $account->set('field_essai_utilise', $essai_utilise ? 1 : 0);
    if ($expiry) {
      $account->set('field_pack_expire_le', $expiry->format('Y-m-d'));
    }
    $account->save();
  }

  $order->setData('unisonges_course_rights_applied', TRUE);
  $order->save();
}

function unisonges_structure_webform_submission_insert(\Drupal\webform\WebformSubmissionInterface $webform_submission): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  _unisonges_structure_queue_google_calendar_booking_sync($webform_submission, 'pending_create');

  $uid = (int) $webform_submission->getOwnerId();
  if (!$uid) {
    return;
  }

  $account = \Drupal\user\Entity\User::load($uid);
  if (!$account) {
    return;
  }

  if (!$account->hasField('field_seances_restantes')) {
    \Drupal::logger('unisonges_structure')->error('Reservation submission @sid could not decrement credits for user @uid because field_seances_restantes is missing.', [
      '@sid' => $webform_submission->id(),
      '@uid' => $uid,
    ]);
    return;
  }

  $remaining = (int) ($account->get('field_seances_restantes')->value ?? 0);
  if ($remaining <= 0) {
    return;
  }

  $remaining = max(0, $remaining - 1);
  $account->set('field_seances_restantes', $remaining);

  if ($remaining === 0 && $account->hasField('field_pack_expire_le') && !$account->get('field_pack_expire_le')->isEmpty()) {
    $account->set('field_pack_expire_le', NULL);
  }

  $account->save();

  _unisonges_structure_log_booking_transition($webform_submission, 'insert', NULL);
}

function unisonges_structure_webform_submission_update(\Drupal\webform\WebformSubmissionInterface $webform_submission): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $original_reservation = NULL;
  if (isset($webform_submission->original) && $webform_submission->original instanceof \Drupal\webform\WebformSubmissionInterface) {
    $original_reservation = _unisonges_structure_get_submission_element_string($webform_submission->original, 'reservation');
  }

  $current_reservation = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
  if ($current_reservation !== '' && $original_reservation !== $current_reservation) {
    $sync_action = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'pending_cancel' : 'pending_update';
    _unisonges_structure_queue_google_calendar_booking_sync($webform_submission, $sync_action);
  }

  _unisonges_structure_log_booking_transition($webform_submission, 'update', $original_reservation);
}

function _unisonges_structure_log_booking_transition(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $trigger, ?string $original_reservation = NULL): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  $current_reservation = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
  $transition = 'unchanged';

  if ($trigger === 'insert') {
    $transition = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'insert_cancelled' : 'created';
  }
  elseif ($original_reservation === NULL) {
    $transition = _unisonges_structure_is_cancelled_booking_value($current_reservation) ? 'cancelled_no_original' : 'updated_no_original';
  }
  elseif ($original_reservation === $current_reservation) {
    $transition = 'unchanged';
  }
  elseif (!_unisonges_structure_is_cancelled_booking_value($original_reservation) && _unisonges_structure_is_cancelled_booking_value($current_reservation)) {
    $transition = 'cancelled';
  }
  elseif ($original_reservation === '' && $current_reservation !== '') {
    $transition = 'created';
  }
  else {
    $transition = 'modified';
  }

  \Drupal::logger('unisonges_booking_sync')->notice(
    'Booking @transition on @webform_id submission @sid (uid=@uid, uuid=@uuid, trigger=@trigger, old=@old, new=@new).',
    [
      '@transition' => $transition,
      '@webform_id' => $webform_submission->getWebform()->id(),
      '@sid' => $webform_submission->id(),
      '@uid' => $webform_submission->getOwnerId(),
      '@uuid' => $webform_submission->uuid(),
      '@trigger' => $trigger,
      '@old' => $original_reservation ?? '',
      '@new' => $current_reservation,
    ]
  );
}

function _unisonges_structure_is_cancelled_booking_value(?string $value): bool {
  return unisonges_structure_is_cancelled_booking_value($value);
}

/**
 * UNISONGES_GOOGLE_CALENDAR_BOOKING_SYNC_SKELETON
 *
 * This skeleton only stores internal dry-run Google Calendar event payloads
 * for course bookings. It does not perform OAuth, call Google APIs, send
 * events externally, or create a real system cron task.
 *
 * Next step: add Google OAuth/API integration, then process this table from
 * a Drupal cron or queue runner scheduled every 5 minutes.
 */

/**
 * Parses a webform_booking reservation value.
 */
function unisonges_structure_parse_booking_reservation_value(?string $value): ?array {
  $value = trim((string) $value);
  if ($value === '') {
    return NULL;
  }

  if (preg_match('/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})\|(\d+)$/', $value, $matches) !== 1) {
    return NULL;
  }

  $timezone = _unisonges_structure_get_booking_sync_timezone();
  try {
    $start = new \DateTimeImmutable($matches[1] . ' ' . $matches[2], new \DateTimeZone($timezone));
  }
  catch (\Throwable $e) {
    return NULL;
  }

  if ($start->format('Y-m-d H:i') !== $matches[1] . ' ' . $matches[2]) {
    return NULL;
  }

  $seats = (int) $matches[3];
  return [
    'raw' => $value,
    'date' => $matches[1],
    'time' => $matches[2],
    'seats' => $seats,
    'cancelled' => $seats === 0,
    'start' => $start,
    'timezone' => $timezone,
  ];
}

/**
 * Determines whether a reservation value is a webform_booking cancellation.
 */
function unisonges_structure_is_cancelled_booking_value(?string $value): bool {
  $parsed = unisonges_structure_parse_booking_reservation_value($value);
  if ($parsed !== NULL) {
    return !empty($parsed['cancelled']);
  }

  $value = trim((string) $value);
  return $value !== '' && preg_match('/\|0$/', $value) === 1;
}

/**
 * Builds a Google Calendar event payload without sending it.
 */
function unisonges_structure_build_google_calendar_dry_run_payload(\Drupal\webform\WebformSubmissionInterface $webform_submission): ?array {
  $reservation = unisonges_structure_parse_booking_reservation_value(
    _unisonges_structure_get_submission_element_string($webform_submission, 'reservation')
  );
  if ($reservation === NULL || !$reservation['start'] instanceof \DateTimeImmutable) {
    return NULL;
  }

  $slot_duration = _unisonges_structure_get_booking_slot_duration_minutes($webform_submission);
  $end = $reservation['start']->modify('+' . $slot_duration . ' minutes');
  $timezone = (string) $reservation['timezone'];

  return [
    'summary' => _unisonges_structure_build_booking_google_summary($webform_submission),
    'location' => _unisonges_structure_build_booking_google_location($webform_submission),
    'description' => _unisonges_structure_build_booking_google_description($webform_submission),
    'start' => [
      'dateTime' => $reservation['start']->format(\DateTimeInterface::RFC3339),
      'timeZone' => $timezone,
    ],
    'end' => [
      'dateTime' => $end->format(\DateTimeInterface::RFC3339),
      'timeZone' => $timezone,
    ],
    'extendedProperties' => [
      'private' => [
        'drupal_webform_id' => $webform_submission->getWebform()->id(),
        'drupal_submission_id' => (string) $webform_submission->id(),
        'drupal_submission_uuid' => (string) $webform_submission->uuid(),
        'unisonges_sync_version' => '1',
      ],
    ],
  ];
}

/**
 * Queues an internal dry-run Google Calendar sync action.
 */
function _unisonges_structure_queue_google_calendar_booking_sync(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $sync_action): void {
  if ($webform_submission->getWebform()->id() !== 'cours_particuliers_reservation') {
    return;
  }

  if (!in_array($sync_action, ['pending_create', 'pending_update', 'pending_cancel'], TRUE)) {
    return;
  }

  $reservation_value = _unisonges_structure_get_submission_element_string($webform_submission, 'reservation');
  if ($reservation_value === '') {
    return;
  }

  $sid = (int) $webform_submission->id();
  if ($sid <= 0) {
    return;
  }

  $table = _unisonges_structure_booking_sync_table_name();
  if (!_unisonges_structure_booking_sync_table_exists()) {
    static $missing_table_logged = FALSE;
    if (!$missing_table_logged) {
      \Drupal::logger('unisonges_booking_sync')->warning('Booking sync table @table is missing; dry-run queue skipped until database updates run.', [
        '@table' => $table,
      ]);
      $missing_table_logged = TRUE;
    }
    return;
  }

  $payload = unisonges_structure_build_google_calendar_dry_run_payload($webform_submission);
  $payload_json = NULL;
  $last_error = NULL;
  if ($payload === NULL) {
    $last_error = 'Unable to build dry-run Google Calendar payload from reservation value.';
  }
  else {
    $payload_json = json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($payload_json === FALSE) {
      $payload_json = NULL;
      $last_error = 'Unable to JSON encode dry-run Google Calendar payload.';
    }
  }

  $now = \Drupal::time()->getRequestTime();
  $cancelled = $sync_action === 'pending_cancel' || _unisonges_structure_is_cancelled_booking_value($reservation_value) ? $now : NULL;
  $fields = [
    'submission_uuid' => (string) $webform_submission->uuid(),
    'sync_status' => 'pending',
    'sync_action' => $sync_action,
    'reservation_value' => $reservation_value,
    'payload_json' => $payload_json,
    'last_error' => $last_error,
    'changed' => $now,
    'cancelled' => $cancelled,
  ];

  try {
    \Drupal::database()->merge($table)
      ->keys(['sid' => $sid])
      ->insertFields($fields + [
        'sid' => $sid,
        'google_event_id' => NULL,
        'created' => $now,
        'last_synced' => NULL,
      ])
      ->updateFields($fields)
      ->execute();

    \Drupal::logger('unisonges_booking_sync')->notice(
      'Booking Google Calendar dry-run sync queued as @action for submission @sid (uuid=@uuid, reservation=@reservation).',
      [
        '@action' => $sync_action,
        '@sid' => $sid,
        '@uuid' => $webform_submission->uuid(),
        '@reservation' => $reservation_value,
      ]
    );
  }
  catch (\Throwable $e) {
    \Drupal::logger('unisonges_booking_sync')->error(
      'Booking Google Calendar dry-run sync queue failed for submission @sid: @message',
      [
        '@sid' => $sid,
        '@message' => $e->getMessage(),
      ]
    );
  }
}

/**
 * Returns the internal sync table name.
 */
function _unisonges_structure_booking_sync_table_name(): string {
  return 'unisonges_structure_booking_gcal_sync';
}

/**
 * Checks whether the internal sync table is available.
 */
function _unisonges_structure_booking_sync_table_exists(): bool {
  try {
    return \Drupal::database()->schema()->tableExists(_unisonges_structure_booking_sync_table_name());
  }
  catch (\Throwable $e) {
    return FALSE;
  }
}

/**
 * Returns a submission element value as a compact string.
 */
function _unisonges_structure_get_submission_element_string(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): string {
  $value = $webform_submission->getElementData($element_key);
  if ($value === NULL) {
    return '';
  }

  if (is_array($value)) {
    $parts = [];
    foreach ($value as $item) {
      if (is_scalar($item)) {
        $parts[] = trim((string) $item);
      }
    }
    return trim(implode(', ', array_filter($parts, 'strlen')));
  }

  if (is_bool($value)) {
    return $value ? '1' : '0';
  }

  if (!is_scalar($value)) {
    return '';
  }

  return trim((string) $value);
}

/**
 * Resolves the site timezone used for booking dry-run payloads.
 */
function _unisonges_structure_get_booking_sync_timezone(): string {
  $timezone = '';
  try {
    $timezone = (string) \Drupal::config('unisonges_structure.google_calendar')->get('timezone');
  }
  catch (\Throwable $e) {
    $timezone = '';
  }

  if ($timezone === '') {
    $timezone = 'Europe/Paris';
  }

  try {
    new \DateTimeZone($timezone);
  }
  catch (\Throwable $e) {
    return 'Europe/Paris';
  }

  return $timezone;
}

/**
 * Reads the webform_booking slot duration from the reservation element.
 */
function _unisonges_structure_get_booking_slot_duration_minutes(\Drupal\webform\WebformSubmissionInterface $webform_submission): int {
  $element = _unisonges_structure_get_webform_element_definition($webform_submission, 'reservation');
  $duration = isset($element['#slot_duration']) ? (int) $element['#slot_duration'] : 0;

  return $duration > 0 ? $duration : 60;
}

/**
 * Returns a webform element definition when available.
 */
function _unisonges_structure_get_webform_element_definition(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): array {
  $webform = $webform_submission->getWebform();

  try {
    if (method_exists($webform, 'getElementDecoded')) {
      $element = $webform->getElementDecoded($element_key);
      if (is_array($element)) {
        return $element;
      }
    }

    if (method_exists($webform, 'getElementsDecoded')) {
      $elements = $webform->getElementsDecoded();
      if (isset($elements[$element_key]) && is_array($elements[$element_key])) {
        return $elements[$element_key];
      }
    }
  }
  catch (\Throwable $e) {
    return [];
  }

  return [];
}

/**
 * Builds the Google Calendar summary for a course booking.
 */
function _unisonges_structure_build_booking_google_summary(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $parts = ['Cours particulier'];
  foreach (['instrument', 'mode_cours'] as $element_key) {
    $label = _unisonges_structure_get_submission_option_label($webform_submission, $element_key);
    if ($label !== '') {
      $parts[] = $label;
    }
  }

  $owner = $webform_submission->getOwner();
  if ($owner && trim($owner->getDisplayName()) !== '') {
    $parts[] = trim($owner->getDisplayName());
  }

  return implode(' - ', $parts);
}

/**
 * Builds the Google Calendar location for a course booking.
 */
function _unisonges_structure_build_booking_google_location(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $mode = _unisonges_structure_get_submission_element_string($webform_submission, 'mode_cours');
  if ($mode === 'domicile') {
    $address = _unisonges_structure_get_submission_element_string($webform_submission, 'adresse_domicile');
    return $address !== '' ? $address : 'Domicile';
  }

  if ($mode === 'visio') {
    $platform = _unisonges_structure_get_submission_option_label($webform_submission, 'plateforme_visio');
    return $platform !== '' ? $platform : 'Visio';
  }

  if ($mode === 'studio') {
    // Confirmed from the current webform description; make configurable before real sync.
    return '1 rue du chemin vert, 93300 Aubervilliers';
  }

  return '';
}

/**
 * Builds the Google Calendar description for a course booking.
 */
function _unisonges_structure_build_booking_google_description(\Drupal\webform\WebformSubmissionInterface $webform_submission): string {
  $lines = [
    'sid: ' . (string) $webform_submission->id(),
    'uuid: ' . (string) $webform_submission->uuid(),
    'uid: ' . (string) $webform_submission->getOwnerId(),
    'telephone: ' . _unisonges_structure_get_submission_element_string($webform_submission, 'telephone'),
    'instrument: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'instrument'),
    'niveau_cours: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'niveau_cours'),
    'notes_supplementaires: ' . _unisonges_structure_get_submission_element_string($webform_submission, 'notes_supplementaires'),
    'didgeridoo_pret: ' . _unisonges_structure_get_submission_option_label($webform_submission, 'didgeridoo_pret'),
  ];

  return implode("\n", $lines);
}

/**
 * Returns an option label for a submitted value when the webform exposes it.
 */
function _unisonges_structure_get_submission_option_label(\Drupal\webform\WebformSubmissionInterface $webform_submission, string $element_key): string {
  $value = _unisonges_structure_get_submission_element_string($webform_submission, $element_key);
  if ($value === '') {
    return '';
  }

  $element = _unisonges_structure_get_webform_element_definition($webform_submission, $element_key);
  $options = $element['#options'] ?? [];
  if (!is_array($options)) {
    return $value;
  }

  if (isset($options[$value]) && is_scalar($options[$value])) {
    return trim((string) $options[$value]);
  }

  return $value;
}
