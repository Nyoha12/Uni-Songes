        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Unix timestamp of the latest successfully finalized create, update, or cancel.',
      ],
      'remote_etag' => [
        'type' => 'varchar_ascii',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Restricted remote version metadata when safely available.',
      ],
      'last_error_code' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Allowlisted non-sensitive machine error code.',
      ],
      'last_error_summary' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Fixed operator-safe error summary; never a raw exception or response.',
