      'next_retry_at' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Earliest Unix timestamp for the next bounded retry.',
      ],
      'claim_mode' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => FALSE,
        'description' => 'Internal work or reconciliation claim mode; not a public operational state.',
      ],
      'lease_owner' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
        'description' => 'Opaque identity of the worker owning the processing lease.',
      ],
      'lease_expires_at' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Unix timestamp when the processing lease expires.',
