        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Source Commerce order item ID.',
      ],
      'credit_index' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Stable one-based credit index within the source order item.',
