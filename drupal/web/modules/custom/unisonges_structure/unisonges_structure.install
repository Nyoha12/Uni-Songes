      'payload_json' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Deprecated legacy payload JSON; unsafe for diagnostics and new operational writes.',
      ],
      'last_error' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Deprecated unredacted legacy error; unsafe for diagnostics.',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the mapping row was created.',
