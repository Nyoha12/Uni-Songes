    'primary key' => ['id'],
    'unique keys' => [
      'sid' => ['sid'],
      'submission_uuid' => ['submission_uuid'],
    ],
    'indexes' => [
      'sync_queue' => ['sync_status', 'sync_action', 'changed'],
      'google_event_id' => ['google_event_id'],
      'last_synced' => ['last_synced'],
      'gcal_state_claim' => ['state', 'next_retry_at', 'lease_expires_at', 'changed', 'id'],
      'gcal_lease_recovery' => ['state', 'lease_expires_at', 'id'],
      'gcal_state_diagnostic' => ['state', 'operation', 'last_attempt_at', 'id'],
    ],
