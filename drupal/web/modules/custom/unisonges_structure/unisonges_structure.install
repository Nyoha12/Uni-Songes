/**
 * Add the disabled Google Calendar operational-state foundation.
 *
 * Existing rows deliberately retain NULL operational fields. This expand hook
 * does not classify backlog, migrate payloads/errors, load credentials, select
 * a Calendar target, or invoke a worker.
 */
function unisonges_structure_update_11004(): void {
  $table = 'unisonges_structure_booking_gcal_sync';
  $database_schema = \Drupal::database()->schema();
  if (!$database_schema->tableExists($table)) {
    throw new \RuntimeException('Google Calendar mapping table is missing; update 11001 must be repaired before 11004.');
  }

  // Frozen 11004 specifications: never replace these with hook_schema() output.
  $fields = [
    'reservation_ref' => [
      'type' => 'varchar_ascii',
      'length' => 96,
      'not null' => FALSE,
      'description' => 'Environment-scoped opaque reservation reference for initialized operational rows.',
    ],
    'operation' => [
      'type' => 'varchar_ascii',
      'length' => 16,
      'not null' => FALSE,
      'description' => 'Desired operation: create, update, or cancel. NULL identifies an unmigrated legacy row.',
    ],
    'desired_revision' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Monotonic source revision used to reject duplicate or out-of-order desired intent.',
    ],
    'processing_operation' => [
      'type' => 'varchar_ascii',
      'length' => 16,
      'not null' => FALSE,
      'description' => 'Immutable operation snapshot owned by the current processing lease.',
    ],
    'state' => [
      'type' => 'varchar_ascii',
      'length' => 32,
      'not null' => FALSE,
      'description' => 'Reviewed operational state. NULL identifies an unmigrated legacy row.',
    ],
    'generation' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Monotonic compare-and-swap version for an initialized operational row.',
    ],
    'attempt_count' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Bounded attempts in the current desired-operation retry window.',
    ],
    'first_queued_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Unix timestamp when this operational record was first queued.',
    ],
    'retry_window_started_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Unix timestamp anchoring the current bounded retry window.',
    ],
    'last_attempt_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Unix timestamp of the latest claim attempt.',
    ],
    'next_retry_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Earliest Unix timestamp for the next bounded retry.',
    ],
    'claim_mode' => [
      'type' => 'varchar_ascii',
      'length' => 16,
      'not null' => FALSE,
      'description' => 'Internal work or reconciliation claim mode; not a public operational state.',
    ],
    'lease_owner' => [
      'type' => 'varchar_ascii',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Opaque identity of the worker owning the processing lease.',
    ],
    'lease_expires_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Unix timestamp when the processing lease expires.',
    ],
    'lease_generation' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Generation captured by the current lease and required for renewal/finalization.',
    ],
    'last_successful_sync_at' => [
      'type' => 'int',
      'size' => 'big',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Unix timestamp of the latest successfully finalized create, update, or cancel.',
    ],
    'remote_etag' => [
      'type' => 'varchar_ascii',
      'length' => 255,
      'not null' => FALSE,
      'description' => 'Restricted remote version metadata when safely available.',
    ],
    'last_error_code' => [
      'type' => 'varchar_ascii',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Allowlisted non-sensitive machine error code.',
    ],
    'last_error_summary' => [
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'description' => 'Fixed operator-safe error summary; never a raw exception or response.',
    ],
  ];

  foreach ($fields as $field_name => $specification) {
    if (!$database_schema->fieldExists($table, $field_name)) {
      $database_schema->addField($table, $field_name, $specification);
    }
  }

  $indexes = [
    'gcal_state_claim' => ['state', 'next_retry_at', 'lease_expires_at', 'changed', 'id'],
    'gcal_lease_recovery' => ['state', 'lease_expires_at', 'id'],
    'gcal_state_diagnostic' => ['state', 'operation', 'last_attempt_at', 'id'],
  ];
  $index_spec = [
    'fields' => $fields + [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'changed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the mapping row was last changed.',
      ],
    ],
    'indexes' => $indexes,
  ];
  foreach ($indexes as $index_name => $columns) {
    if (!$database_schema->indexExists($table, $index_name)) {
      $database_schema->addIndex($table, $index_name, $columns, $index_spec);
    }
  }

  // Active-only legacy config is unknown, so upgrades are forced back to hold.
  $config = \Drupal::configFactory()->getEditable('unisonges_structure.google_calendar');
  $config
    ->set('enabled', FALSE)
    ->set('dry_run', TRUE)
    ->set('token_provider', 'disabled')
    ->save(TRUE);
}
