<?php

/**
 * @file
 * Install, update, and schema hooks for the Unisonges Structure module.
 */

/**
 * Implements hook_schema().
 */
function unisonges_structure_schema(): array {
  $schema['unisonges_structure_booking_gcal_sync'] = [
    'description' => 'Legacy-compatible Google Calendar booking mapping and disabled operational-state foundation.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'sid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Webform submission ID.',
      ],
      'submission_uuid' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Webform submission UUID.',
      ],
      'google_event_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Restricted legacy or precommitted remote event ID; preserved during migration.',
      ],
      'sync_status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'pending',
        'description' => 'Deprecated legacy status; not the reviewed operational state machine.',
      ],
      'sync_action' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'pending_create',
        'description' => 'Deprecated legacy action that combines pending state with operation.',
      ],
      'reservation_ref' => [
        'type' => 'varchar_ascii',
        'length' => 96,
        'not null' => FALSE,
        'description' => 'Environment-scoped opaque reservation reference for initialized operational rows.',
      ],
      'operation' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => FALSE,
        'description' => 'Desired operation: create, update, or cancel. NULL identifies an unmigrated legacy row.',
      ],
      'desired_revision' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Monotonic source revision used to reject duplicate or out-of-order desired intent.',
      ],
      'processing_operation' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => FALSE,
        'description' => 'Immutable operation snapshot owned by the current processing lease.',
      ],
      'state' => [
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => FALSE,
        'description' => 'Reviewed operational state. NULL identifies an unmigrated legacy row.',
