      'changed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when the mapping row was last changed.',
      ],
      'last_synced' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Deprecated ambiguous legacy success timestamp.',
      ],
      'cancelled' => [
